#!/usr/bin/env bash
# Hand a PR's merge tail to the zero-token pr-babysit patrol.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="gastownhall/beads"
METHOD="squash"
FLAKE_RERUN="allowed"
PR=""
BEAD_OVERRIDE=""
BASE_FIX=0

usage() {
  echo "usage: pr-handoff <pr-number> [--repo owner/repo] [--method squash|merge|rebase] [--no-flake-rerun] [--bead <id>] [--base-fix]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      REPO="$2"; shift 2 ;;
    --method)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      METHOD="$2"; shift 2 ;;
    --bead)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      BEAD_OVERRIDE="$2"; shift 2 ;;
    --no-flake-rerun) FLAKE_RERUN="no"; shift ;;
    --base-fix) BASE_FIX=1; shift ;;
    -*) usage; exit 2 ;;
    *)
      [[ -z "$PR" ]] || { usage; exit 2; }
      PR="$1"; shift ;;
  esac
done

[[ "$PR" =~ ^[1-9][0-9]*$ ]] || { usage; exit 2; }
[[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { usage; exit 2; }
[[ "$METHOD" =~ ^(squash|merge|rebase)$ ]] || { usage; exit 2; }
[[ -z "$BEAD_OVERRIDE" || "$BEAD_OVERRIDE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { usage; exit 2; }

cd "$ROOT" || exit 1
pr_json="$(gh pr view "$PR" --repo "$REPO" --json title,state,baseRefName 2>/dev/null)" || { echo "cannot read PR" >&2; exit 1; }
title="$(jq -er '.title | strings | select(length > 0)' <<<"$pr_json")" || { echo "malformed PR data" >&2; exit 1; }
[[ "$(jq -r '.state // empty' <<<"$pr_json")" == "OPEN" ]] || { echo "PR is not OPEN" >&2; exit 1; }

# --base-fix is the stop-the-line exception (bead mybd-01yzj).  Ordinarily a red
# base holds every lane behind it, which is right — merging onto a red base
# hides new failures.  For the PR that IS the base fix it deadlocks: the base
# cannot go green until this PR merges, and the patrol will not merge it until
# the base is green.  The flag names the exact base this PR remedies; the patrol
# then merges on the PR's OWN green checks while that base is red, and only when
# the red base is the sole preflight objection.  It is inert on a green base and
# inert if the PR's base changes, so it cannot become a standing merge licence.
BASE_FIX_KEY=""
if (( BASE_FIX )); then
  base_ref="$(jq -er '.baseRefName | strings | select(length > 0)' <<<"$pr_json")" || { echo "cannot read PR base branch" >&2; exit 1; }
  BASE_FIX_KEY="$REPO@$base_ref"
fi

canonical="gh:$REPO#$PR"
legacy="gh-pr-$PR"
if [[ -n "$BEAD_OVERRIDE" ]]; then
  bead="$BEAD_OVERRIDE"
  selected="$(bd show "$bead" --json 2>/dev/null)" || { echo "cannot inspect bead $bead" >&2; exit 1; }
  selected_ref="$(jq -er '.[0].external_ref // ""' <<<"$selected")" || { echo "malformed bead $bead" >&2; exit 1; }
  if [[ -n "$selected_ref" && "$selected_ref" != "$canonical" && ! ( "$REPO" == "gastownhall/beads" && "$selected_ref" == "$legacy" ) ]]; then
    echo "bead $bead belongs to $selected_ref, not $canonical" >&2
    exit 1
  fi
else
  matches="$(bd list --json --external-ref "$canonical" 2>/dev/null | jq -r '.[].id // empty')"
  if [[ "$REPO" == "gastownhall/beads" ]]; then
    matches+=$'\n'"$(bd list --json --external-ref "$legacy" 2>/dev/null | jq -r '.[].id // empty')"
  fi
  matches="$(sort -u <<<"$matches" | sed '/^$/d')"
  match_count="$(wc -l <<<"$matches" | tr -d ' ')"
  (( match_count <= 1 )) || { echo "ambiguous merge-tail beads for $canonical" >&2; exit 1; }
  bead="$matches"
fi

if [[ -z "$bead" ]]; then
  bead="$(bd create --title="$title" --description="Upstream PR: https://github.com/$REPO/pull/$PR — merge tail handed to pr-babysit patrol." --type=task --priority=2 --external-ref="$canonical" --json | jq -r '.id // .[0].id')"
  [[ -n "$bead" ]] || exit 1
fi

existing="$(bd show "$bead" --json 2>/dev/null)" || true
if jq -e '(.[0].labels // []) | index("close-when-quiet")' >/dev/null 2>/dev/null <<<"${existing:-}"; then
  echo "bead $bead already carries close-when-quiet; a PR cannot be in both lanes" >&2
  exit 1
fi

bd update "$bead" --claim --add-label merge-when-green --external-ref "$canonical" \
  --set-metadata "pr_babysit_repo=$REPO" \
  --set-metadata "pr_babysit_pr=$PR" \
  --set-metadata "pr_babysit_method=$METHOD" \
  --set-metadata "pr_babysit_flake_rerun=$FLAKE_RERUN" \
  --set-metadata "pr_babysit_base_fix=$BASE_FIX_KEY" \
  --set-metadata pr_babysit_last_transition= \
  --append-notes "[pr-handoff $(date -u +%FT%TZ)] repo=$REPO pr=$PR method=$METHOD flake_rerun=$FLAKE_RERUN${BASE_FIX_KEY:+ base_fix=$BASE_FIX_KEY} — patrol owns the merge; sessions hand off here." \
  >/dev/null

echo "handed off: $REPO#$PR -> bead $bead"
if [[ -n "$BASE_FIX_KEY" ]]; then
  echo "BASE-FIX: the patrol may merge this PR while $BASE_FIX_KEY is RED, on this PR's own green checks."
  echo "          Every other preflight block still holds, and the exception is inert once $BASE_FIX_KEY is green."
fi
# The pr-babysit patrol is a systemd user timer, so this check only means
# something on a systemd host. On a host with no systemctl at all (Windows Git
# Bash, macOS) the warning below would be wrong and actionable-looking — there
# is no local timer to enable. This machine is not the designated babysitter
# (see AGENTS.md "PR Merge Tails (babysitter pattern)"); the handoff still
# reaches the patrol, but only once bd state syncs there, so say that instead.
if command -v systemctl >/dev/null 2>&1; then
  if ! systemctl --user is-active --quiet pr-babysit.timer 2>/dev/null; then
    echo "WARNING: pr-babysit.timer is not active. Enable with: scripts/install-pr-babysit" >&2
  fi
else
  echo "NOTE: the designated Linux machine runs the pr-babysit patrol, not this host. Run 'bd dolt push' at session close so this handoff reaches its queue." >&2
fi
