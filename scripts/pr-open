#!/usr/bin/env bash
# pr-open - upstream preflight + red-team loop + cross-vendor review, before a
# PR exists.
#
# The three things that must happen before `gh pr create` against
# gastownhall/beads, in one verb:
#
#   1. bd-main/scripts/pr-preflight.sh --search "<topic>"   (is someone already
#      doing this? is the base green?)
#   2. scripts/red-team -C <dir> --base <base>              (an adversary tries
#      to break the change; builder fixes P0/P1 findings, max 3 rounds; an
#      exhausted branch files a bead and this script stops - do not open)
#   3. scripts/codex-agent reviewer --diff --base <base>    (a second model
#      family on the diff, per AGENTS.md "Second opinion across model vendors")
#
# Red-team runs BEFORE the review: its fix rounds move HEAD, and the review
# log must vouch for the commit actually being proposed.
#
# The review is written to a log keyed by the HEAD sha. scripts/pr-review-gate
# reads that log: `gh pr create` is blocked until one exists for the exact
# commit being proposed, so amending after a review re-arms the gate rather
# than riding the old verdict.
#
# This deliberately stops before creating the PR. Reconciling findings is
# judgment - some are wrong, some are pre-existing rather than regressions (bd
# memory dual-vendor-review-disagreement), and a wrapper that opened the PR the
# moment the review returned would be automating the one step that has to be
# thought about.
#
# Usage:
#   scripts/pr-open [-C <dir>] [--base <branch>] [--repo owner/repo]
#                   [--search "<topic keywords>"] [--skip-preflight]
#                   [--allow-dirty] [--prompt "<extra review focus>"]
#                   [--skip-redteam] [--redteam-no-fix]
#
#   --skip-redteam:   skip the adversarial stage (MYBD_SKIP_REDTEAM=1 does the
#                     same); the gate will then require the same skip spelled
#                     out on the gh pr create command line.
#   --redteam-no-fix: run the adversary but leave fixing to the calling
#                     session (passes --no-fix through to scripts/red-team).
#
# Exit codes: 0 review written · 1 error · 2 usage · 3 preflight objected ·
#             4 red-team exhausted with open P0/P1 (bead filed - do not open) ·
#             5 red-team findings open, rounds remain (--redteam-no-fix).

set -euo pipefail
# Agent shells may lack linuxbrew on PATH (bead mybd-zvups); repair before probing tools.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/brew-path.sh"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Anchor on the MAIN checkout: a copy of this script running from a linked
# worktree must still write where scripts/pr-review-gate reads, or a review
# would be invisible to the gate that asked for it.
_common="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[[ -n "$_common" ]] && ROOT="$(dirname "$_common")"
REVIEW_DIR="$ROOT/.worktrees/.review-logs"

workdir="$PWD"
base="main"
repo="gastownhall/beads"
search=""
prompt=""
skip_preflight=0
allow_dirty=0
skip_redteam=0
redteam_no_fix=0
[[ "${MYBD_SKIP_REDTEAM:-0}" == "1" ]] && skip_redteam=1

usage() { sed -n '2,49p' "$0" | sed 's/^# \{0,1\}//' >&2; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -C|--cd)   [[ $# -ge 2 ]] || { usage; exit 2; }; workdir="$2"; shift 2 ;;
    --base)    [[ $# -ge 2 ]] || { usage; exit 2; }; base="$2"; shift 2 ;;
    --repo)    [[ $# -ge 2 ]] || { usage; exit 2; }; repo="$2"; shift 2 ;;
    --search)  [[ $# -ge 2 ]] || { usage; exit 2; }; search="$2"; shift 2 ;;
    --prompt)  [[ $# -ge 2 ]] || { usage; exit 2; }; prompt="$2"; shift 2 ;;
    --skip-preflight) skip_preflight=1; shift ;;
    --allow-dirty)    allow_dirty=1; shift ;;
    --skip-redteam)   skip_redteam=1; shift ;;
    --redteam-no-fix) redteam_no_fix=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "pr-open: unexpected argument '$1'" >&2; usage; exit 2 ;;
  esac
done

[[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "pr-open: bad --repo '$repo'" >&2; exit 2; }

workdir="$(cd "$workdir" 2>/dev/null && pwd)" || { echo "pr-open: no such directory: $workdir" >&2; exit 1; }
git -C "$workdir" rev-parse --git-dir >/dev/null 2>&1 || { echo "pr-open: not a git checkout: $workdir" >&2; exit 1; }

# The log is keyed by sha, so the tree must actually BE that sha. A dirty tree
# would produce a review of code the sha does not contain, and the gate would
# then wave through a commit nothing reviewed.
if (( ! allow_dirty )) && [[ -n "$(git -C "$workdir" status --porcelain)" ]]; then
  echo "pr-open: working tree is dirty in $workdir." >&2
  echo "  Commit first — the review log is keyed to HEAD, and a review of" >&2
  echo "  uncommitted work would vouch for a commit that does not contain it." >&2
  echo "  (--allow-dirty to override deliberately.)" >&2
  exit 1
fi

head_sha="$(git -C "$workdir" rev-parse HEAD)"
branch="$(git -C "$workdir" rev-parse --abbrev-ref HEAD)"

if (( ! skip_preflight )); then
  preflight="$ROOT/bd-main/scripts/pr-preflight.sh"
  if [[ -x "$preflight" ]]; then
    if [[ -n "$search" ]]; then
      echo "== preflight: $search"
      "$preflight" --search "$search" --repo "$repo" || { echo "pr-open: preflight objected." >&2; exit 3; }
    else
      echo "pr-open: no --search given; skipping the duplicate-topic check." >&2
      echo "  Pass --search \"<topic keywords>\" so a competing PR is found before you open one." >&2
    fi
  else
    echo "pr-open: $preflight not found or not executable; skipping preflight." >&2
  fi

  # pr-preflight.sh --search returns after `gh pr list`; its base-CI check lives
  # only on the <pr-number> path, which does not exist yet for a PR that has not
  # been opened. So "preflight passed" would quietly mean "nobody checked the
  # base" at exactly the moment stop-the-line matters. Same rule as there:
  # newest decisive run per workflow, cancelled runs carry no signal.
  echo "== base health: $repo@$base"
  base_runs="$(gh run list --repo "$repo" --branch "$base" --status completed \
    --limit 30 --json conclusion,workflowName,createdAt,url 2>/dev/null)" || base_runs=""
  latest_per_wf="$(jq '[group_by(.workflowName)[]
    | [.[] | select((.conclusion // "") == "success" or ((.conclusion // "") | test("^(failure|timed_out|action_required)$")))][0]
    | select(. != null)]' <<<"${base_runs:-[]}" 2>/dev/null || echo '[]')"
  red="$(jq '[.[] | select((.conclusion // "") | test("^(failure|timed_out|action_required)$"))]' <<<"$latest_per_wf")"
  if [[ "$(jq 'length' <<<"$red")" -gt 0 ]]; then
    echo "  RED: $(jq -r 'map("\(.workflowName) (\(.url))") | join("; ")' <<<"$red")" >&2
    if [[ "${PR_PREFLIGHT_BLOCK_RED_BASE:-0}" == "1" ]]; then
      echo "pr-open: $base is red and PR_PREFLIGHT_BLOCK_RED_BASE=1 — stop-the-line." >&2
      echo "  While the base is red the only PR that should be opened is the fix for it." >&2
      echo "  See PR_MAINTAINER_GUIDELINES.md \"Base-Branch Health\"." >&2
      exit 3
    fi
    echo "  (warning only; export PR_PREFLIGHT_BLOCK_RED_BASE=1 to make this a stop)" >&2
  elif [[ "$(jq '[.[] | select(.conclusion == "success")] | length' <<<"$latest_per_wf")" -gt 0 ]]; then
    echo "  green"
  else
    echo "  undetermined — check $base manually before opening" >&2
  fi
fi

if (( ! skip_redteam )); then
  rt_args=(-C "$workdir" --base "$base")
  (( redteam_no_fix )) && rt_args+=(--no-fix)
  (( allow_dirty ))    && rt_args+=(--allow-dirty)
  "$ROOT/scripts/red-team" "${rt_args[@]}" || {
    rt_rc=$?
    if (( rt_rc == 4 )); then
      echo "pr-open: red-team exhausted its rounds with open P0/P1 findings." >&2
      echo "  A bead was filed with the findings. Do NOT open this PR; move to" >&2
      echo "  the next queue item." >&2
    elif (( rt_rc == 5 )); then
      echo "pr-open: red-team found open P0/P1 findings; fix, commit, and re-run." >&2
    elif (( rt_rc == 6 )); then
      echo "pr-open: red-team refused a clean rerun on an unchanged previously-failing" >&2
      echo "  commit. Commit a fix before re-running." >&2
    else
      echo "pr-open: red-team failed (exit $rt_rc); not proceeding to review." >&2
    fi
    exit "$rt_rc"
  }
  # Red-team fix rounds commit, so HEAD may have moved: the review below must
  # cover the commit the PR will actually propose.
  head_sha="$(git -C "$workdir" rev-parse HEAD)"
  branch="$(git -C "$workdir" rev-parse --abbrev-ref HEAD)"
else
  echo "pr-open: skipping red-team stage (deliberate); the gate will ask for" >&2
  echo "  MYBD_SKIP_REDTEAM=1 on the gh pr create command line." >&2
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "pr-open: codex CLI not on PATH — cannot run the cross-vendor review." >&2
  echo "  Install/authenticate codex, or open the PR with an explicit" >&2
  echo "  MYBD_SKIP_XVENDOR=1 prefix and say why in the PR body." >&2
  exit 1
fi

mkdir -p "$REVIEW_DIR"
log="$REVIEW_DIR/$head_sha.md"
tmp="$(mktemp "${TMPDIR:-/tmp}/pr-open.XXXXXX")"
trap 'rm -f "$tmp" "${staged:-}"' EXIT

echo "== codex reviewer (gpt-5.6-sol, high) on $branch @ ${head_sha:0:12} vs $base"
set +e
if [[ -n "$prompt" ]]; then
  "$ROOT/scripts/codex-agent" reviewer --diff -C "$workdir" --base "$base" "$prompt" </dev/null 2>&1 | tee "$tmp"
else
  "$ROOT/scripts/codex-agent" reviewer --diff -C "$workdir" --base "$base" </dev/null 2>&1 | tee "$tmp"
fi
rc=${PIPESTATUS[0]}
set -e

if (( rc != 0 )); then
  echo "pr-open: codex review exited $rc; no review log written." >&2
  exit 1
fi

# Publish by rename: a log half-written when the machine died would otherwise
# sit there satisfying the gate forever without recording what was reviewed.
staged="$log.staging.$$"
{
  echo "# Cross-vendor pre-PR review"
  echo
  echo "- repo: \`$repo\`"
  echo "- branch: \`$branch\`"
  echo "- head: \`$head_sha\`"
  echo "- base: \`$base\`"
  echo "- reviewer: codex \`gpt-5.6-sol\`, high reasoning (\`codex review --base $base\`)"
  echo "- worktree: \`$workdir\`"
  echo
  echo '## Findings as returned'
  echo
  cat "$tmp"
} > "$staged"
mv -f "$staged" "$log"

cat <<EOF

review log: $log

Next: reconcile every finding against the source before posting — a single
reviewer's severity ranking is not a maintainer decision, and "pre-existing,
not a regression" is the most decision-relevant question you can ask of one
(bd memory dual-vendor-review-disagreement). Then:

  gh pr create --repo $repo --base $base --body-file <file>

If you amend or add commits, HEAD moves and the gate re-arms: run pr-open again
on the final commit.
EOF
