#!/usr/bin/env bash
# Zero-token, fail-closed merge-tail patrol.  It is the only actor that merges
# merge-when-green PRs; every decision is tied to the currently observed SHA.
# It also owns the close-when-quiet lane below: decline dispositions that
# were offered with a quiet window rather than closed on the spot.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pr-babysit"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/patrol.log"
LOCK="$STATE_DIR/lock"
PREFLIGHT="${PR_BABYSIT_PREFLIGHT:-$ROOT/bd-main/scripts/pr-preflight.sh}"
exec 9>"$LOCK"
flock -n 9 || exit 0
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$LOG"; }

# Returns non-zero if the durable control-plane record could not be written.
transition() {
  local bead="$1" metadata="$2" notes="$3" key="$4" message="$5" previous
  previous="$(jq -r '.pr_babysit_last_transition // empty' <<<"$metadata")"
  [[ "$previous" == "$key" ]] && return 0
  [[ -z "$previous" && "$notes" == *"transition=$key"* ]] && return 0
  bd update "$bead" --set-metadata "pr_babysit_last_transition=$key" \
    --append-notes "[pr-babysit $(date -u +%FT%TZ)] transition=$key — $message" >/dev/null 2>&1
}

# Keep the merge-when-green label if any prerequisite mutation fails; the next
# patrol can safely retry.  Do not claim a bead is blocked unless all mutations
# completed.
block() {
  local bead="$1" metadata="$2" notes="$3" key="$4" message="$5"
  local previous args=()
  previous="$(jq -r '.pr_babysit_last_transition // empty' <<<"$metadata")"
  args=(update "$bead" --status open --assignee "" --remove-label merge-when-green --add-label merge-blocked)
  if [[ "$previous" != "$key" && ! ( -z "$previous" && "$notes" == *"transition=$key"* ) ]]; then
    args+=(--set-metadata "pr_babysit_last_transition=$key" --append-notes "[pr-babysit $(date -u +%FT%TZ)] transition=$key — $message")
  fi
  if ! bd "${args[@]}" >/dev/null 2>&1; then log "$bead: block deferred (atomic update failed)"; return 1; fi
  log "$bead: BLOCKED ($message)"
}

legacy_policy() {
  # Only a complete, latest handoff line is authoritative; prose elsewhere is
  # not policy. Output repo<TAB>pr<TAB>method<TAB>rerun or nothing.
  sed -nE 's/^\[pr-handoff [^]]+\] repo=([^ ]+) pr=([1-9][0-9]*) method=(squash|merge|rebase) flake_rerun=(allowed|no) .*/\1\t\2\t\3\t\4/p' <<<"$1" | tail -n1
}

valid_repo_pr() { [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && "$2" =~ ^[1-9][0-9]*$ ]]; }

# Head-scoped counters are stored as "sha:count"; any other head reads as 0.
counter_for_head() {
  local stored="$1" head="$2" n
  [[ "$stored" == "$head":* ]] || { echo 0; return; }
  n="${stored##*:}"
  [[ "$n" =~ ^[0-9]+$ ]] && echo "$n" || echo 0
}

TRANSIENT_BLOCK_RE='^\[block\] (Merge state is (UNKNOWN|UNSTABLE)\.|[0-9]+ status check\(s\) are still pending\.)$'
RED_BASE_BLOCK_RE='^\[block\] Base branch .+ CI is RED(:.*)?$'
TRANSIENT_BLOCK_LIMIT=3   # patrol passes before a transient-only block escalates
CHECKS_UNAVAILABLE_LIMIT=10  # passes with no readable checks before escalation
REARM_LIMIT=2             # automatic re-arms per head before a human owns it
CLOSE_RETRY_LIMIT=10      # consecutive unreadable/malformed close-when-quiet passes before escalation
# Every merge flips mergeStateStatus to UNKNOWN for every other open PR, so a
# green backlog would otherwise drain at one PR per pass while burning the
# others' transient budgets.  On a transient-only block, wait briefly for
# GitHub to recompute and re-run preflight once, bounded per pass so a fully
# transient queue cannot run into the service timeout.
SETTLE_DELAY="${PR_BABYSIT_SETTLE_DELAY:-10}"
SETTLE_RETRIES_PER_PASS=12

# Blocked tails whose observed condition has changed get one path back into
# automation.  Only patrol-written, head-scoped verdicts are re-armable, and
# every re-arm is budgeted per head so a genuinely stuck PR cannot flap.
rearm_sweep() {
  local blocked item bead status assignee metadata key class blocked_head ref repo pr
  local rearm_prev n pr_json state head msstatus checks eligible why
  blocked="$(bd list --label merge-blocked --json 2>/dev/null)" || return 0
  jq -e 'type == "array"' >/dev/null 2>/dev/null <<<"$blocked" || return 0
  while read -r item; do
    bead="$(jq -r '.id // empty' <<<"$item")"; [[ -n "$bead" ]] || continue
    status="$(jq -r '.status // empty' <<<"$item")"; assignee="$(jq -r '.assignee // empty' <<<"$item")"
    # An agent may have claimed the blocked bead to work on it; leave those alone.
    [[ "$status" == open && -z "$assignee" ]] || continue
    jq -e '(.labels // []) | index("merge-when-green") == null' >/dev/null 2>/dev/null <<<"$item" || continue
    metadata="$(jq -c 'if (.metadata? == null) then {} else .metadata end' <<<"$item")"
    jq -e 'type == "object"' >/dev/null 2>/dev/null <<<"$metadata" || continue
    key="$(jq -r '.pr_babysit_last_transition // empty' <<<"$metadata")"
    class="${key%%:*}"; blocked_head="${key##*:}"
    case "$class" in
      checks-persistent|checks-no-rerun-target|rerun-failed|checks-unavailable-persistent|preflight-transient-persistent|preflight-policy) ;;
      *) continue ;;
    esac
    [[ "$blocked_head" =~ ^[0-9a-fA-F]{7,64}$ ]] || continue
    # Identity rules mirror the main loop: metadata is a fallback only for an
    # EMPTY external_ref, a non-empty unparseable ref is never trusted, and a
    # ref/metadata disagreement disqualifies the bead from any mutation.
    ref="$(jq -r '.external_ref // empty' <<<"$item")"
    repo=""; pr=""
    if [[ "$ref" =~ ^gh:([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([1-9][0-9]*)$ ]]; then
      repo="${BASH_REMATCH[1]}"; pr="${BASH_REMATCH[2]}"
    elif [[ "$ref" =~ ^gh-pr-([1-9][0-9]*)$ ]]; then
      repo="gastownhall/beads"; pr="${BASH_REMATCH[1]}"
    elif [[ -n "$ref" ]]; then
      continue
    else
      repo="$(jq -r '.pr_babysit_repo // empty' <<<"$metadata")"; pr="$(jq -r '.pr_babysit_pr // empty' <<<"$metadata")"
    fi
    valid_repo_pr "$repo" "$pr" || continue
    meta_repo="$(jq -r '.pr_babysit_repo // empty' <<<"$metadata")"; meta_pr="$(jq -r '.pr_babysit_pr // empty' <<<"$metadata")"
    if { [[ -n "$meta_repo" || -n "$meta_pr" ]]; } && { [[ "$meta_repo" != "$repo" || "$meta_pr" != "$pr" ]]; }; then
      continue
    fi
    sweep_err="$STATE_DIR/gh-sweep.err"
    pr_json="$(gh pr view "$pr" --repo "$repo" --json state,headRefOid,mergeStateStatus 2>"$sweep_err")" || { [[ -s "$sweep_err" ]] && log "$bead: sweep gh pr view stderr: $(tr '\n' ' ' <"$sweep_err" | cut -c1-200)"; rm -f "$sweep_err"; continue; }
    rm -f "$sweep_err"
    jq -e 'type == "object" and (.state | type == "string") and (.headRefOid | type == "string")' >/dev/null 2>/dev/null <<<"$pr_json" || continue
    state="$(jq -r .state <<<"$pr_json")"; head="$(jq -r .headRefOid <<<"$pr_json")"
    msstatus="$(jq -r '.mergeStateStatus // empty' <<<"$pr_json")"
    if [[ "$state" == MERGED ]]; then
      if bd close "$bead" --reason "PR $repo#$pr merged (observed by pr-babysit re-arm sweep)." >/dev/null 2>&1; then
        log "$bead: $repo#$pr merged while blocked; bead closed"
      else
        log "$bead: close failed (merged while blocked)"
      fi
      continue
    fi
    [[ "$state" == OPEN && "$head" =~ ^[0-9a-fA-F]{7,64}$ ]] || continue
    rearm_prev="$(jq -r '.pr_babysit_rearm // empty' <<<"$metadata")"
    n="$(counter_for_head "$rearm_prev" "$head")"
    (( n < REARM_LIMIT )) || continue
    eligible=0; why=""
    if [[ "$head" != "$blocked_head" ]]; then
      eligible=1; why="PR head moved since the block verdict"
    else
      case "$class" in
        # Genuine policy blocks (draft, changes-requested, conflicts, .beads
        # data) re-enter automation only via a new head: with no server-side
        # review requirement upstream, mergeStateStatus CLEAN says nothing
        # about human judgment, so a same-head retry would erase the durable
        # stop that merge-blocked exists to provide.
        preflight-policy) ;;
        preflight-transient-persistent)
          if [[ "$msstatus" == CLEAN || "$msstatus" == HAS_HOOKS ]]; then
            eligible=1; why="merge state settled to $msstatus"
          fi ;;
        *)
          sweep_err="$STATE_DIR/gh-sweep.err"
          checks="$(gh pr checks "$pr" --repo "$repo" --json name,bucket,link 2>"$sweep_err")" || { [[ -s "$sweep_err" ]] && log "$bead: sweep gh pr checks stderr: $(tr '\n' ' ' <"$sweep_err" | cut -c1-200)"; rm -f "$sweep_err"; continue; }
          rm -f "$sweep_err"
          jq -e 'type == "array" and length > 0 and all(.[]; type == "object" and (.name | type == "string") and (.bucket | type == "string") and (.bucket == "pass" or .bucket == "pending" or .bucket == "fail" or .bucket == "skipping" or .bucket == "cancel"))' >/dev/null 2>/dev/null <<<"$checks" || continue
          if [[ "$(jq '[.[] | select(.bucket == "fail" or .bucket == "cancel")] | length' <<<"$checks")" == 0 ]]; then
            eligible=1; why="checks no longer failing on the blocked head"
          fi ;;
      esac
    fi
    (( eligible )) || continue
    # Reserve the re-arm budget before restoring the label: a crash after the
    # reservation conservatively spends one re-arm for this head.  Both patrol
    # retry counters reset so the re-armed head gets a fresh assessment.
    if ! bd update "$bead" --set-metadata "pr_babysit_rearm=$head:$((n + 1))" --unset-metadata pr_babysit_transient --unset-metadata pr_babysit_checksun >/dev/null 2>&1; then
      log "$bead: re-arm reservation failed"; continue
    fi
    # --claim keeps the tail out of bd ready: a re-armed bead is patrol-owned,
    # exactly as pr-handoff leaves it (2026-07-24 incident shape otherwise).
    if bd update "$bead" --claim --add-label merge-when-green --remove-label merge-blocked \
         --set-metadata "pr_babysit_last_transition=re-armed:$head" \
         --append-notes "[pr-babysit $(date -u +%FT%TZ)] transition=re-armed:$head — $why; restored to patrol." >/dev/null 2>&1; then
      log "$bead: RE-ARMED ($why)"
    else
      log "$bead: re-arm mutation failed"
    fi
  done < <(jq -c '.[]' <<<"$blocked")
}

cd "$ROOT" || exit 1
rearm_sweep
QUEUE="$(bd list --label merge-when-green --json 2>/dev/null)" || { log "bd unavailable; skipping"; exit 0; }
if ! jq -e 'type == "array"' >/dev/null 2>/dev/null <<<"$QUEUE"; then log "bd returned malformed queue data"; exit 0; fi
settle_budget=$SETTLE_RETRIES_PER_PASS

while read -r item; do
  bead="$(jq -r '.id // empty' <<<"$item")"; ref="$(jq -r '.external_ref // empty' <<<"$item")"; notes="$(jq -r '.notes // empty' <<<"$item")"
  [[ -n "$bead" ]] || { log "queue item has no id"; continue; }
  metadata_raw="$(jq -c 'if (.metadata? == null) then {} else .metadata end' <<<"$item")"
  if ! jq -e 'type == "object"' >/dev/null 2>/dev/null <<<"$metadata_raw"; then
    block "$bead" '{}' "$notes" "metadata-malformed" "Bead metadata is not an object; needs agent judgment."
    continue
  fi
  metadata="$metadata_raw"

  # A PR can't be in both lanes; a bead that somehow carries both is left for
  # a human rather than guessed at (mirrors the close lane's own check).
  if jq -e '(.labels // []) | index("close-when-quiet")' >/dev/null 2>/dev/null <<<"$item"; then
    transition "$bead" "$metadata" "$notes" "dual-lane-labels" "Bead carries both merge-when-green and close-when-quiet; needs agent judgment." || log "$bead: transition failed"
    log "$bead: merge-when-green and close-when-quiet both present; retained (needs agent judgment)"
    continue
  fi

  legacy="$(legacy_policy "$notes")"
  legacy_repo="$(cut -f1 <<<"$legacy")"; legacy_pr="$(cut -f2 <<<"$legacy")"; legacy_method="$(cut -f3 <<<"$legacy")"; legacy_rerun="$(cut -f4 <<<"$legacy")"

  repo=""; pr=""
  if [[ "$ref" =~ ^gh:([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([1-9][0-9]*)$ ]]; then
    repo="${BASH_REMATCH[1]}"; pr="${BASH_REMATCH[2]}"
  elif [[ "$ref" =~ ^gh-pr-([1-9][0-9]*)$ ]]; then
    repo="gastownhall/beads"; pr="${BASH_REMATCH[1]}"
  elif [[ -z "$ref" ]]; then
    repo="$(jq -r '.pr_babysit_repo // empty' <<<"$metadata")"; pr="$(jq -r '.pr_babysit_pr // empty' <<<"$metadata")"
    if ! valid_repo_pr "$repo" "$pr"; then repo="$legacy_repo"; pr="$legacy_pr"; fi
    if ! valid_repo_pr "$repo" "$pr"; then
      block "$bead" "$metadata" "$notes" "missing-reference" "No valid external_ref or metadata PR identity; needs agent judgment."
      continue
    fi
  else
    block "$bead" "$metadata" "$notes" "reference-malformed" "Unparseable external_ref; needs agent judgment."
    continue
  fi
  meta_repo="$(jq -r '.pr_babysit_repo // empty' <<<"$metadata")"; meta_pr="$(jq -r '.pr_babysit_pr // empty' <<<"$metadata")"
  if { [[ -n "$meta_repo" || -n "$meta_pr" ]]; } && { [[ "$meta_repo" != "$repo" || "$meta_pr" != "$pr" ]]; }; then
    block "$bead" "$metadata" "$notes" "reference-metadata-mismatch" "external_ref and pr_babysit metadata disagree; needs agent judgment."
    continue
  fi
  if [[ -n "$legacy" ]] && { [[ "$legacy_repo" != "$repo" || "$legacy_pr" != "$pr" ]]; }; then
    block "$bead" "$metadata" "$notes" "reference-legacy-mismatch" "external_ref and legacy handoff identity disagree; needs agent judgment."
    continue
  fi

  # Present metadata must be valid. Only absent/null keys may fall back to the
  # latest exact legacy handoff marker.
  method_present="$(jq 'has("pr_babysit_method") and .pr_babysit_method != null' <<<"$metadata")"
  rerun_present="$(jq 'has("pr_babysit_flake_rerun") and .pr_babysit_flake_rerun != null' <<<"$metadata")"
  method="$(jq -r '.pr_babysit_method // empty' <<<"$metadata")"; rerun_policy="$(jq -r '.pr_babysit_flake_rerun // empty' <<<"$metadata")"
  if [[ "$method_present" == true && ! "$method" =~ ^(squash|merge|rebase)$ ]] || [[ "$rerun_present" == true && ! "$rerun_policy" =~ ^(allowed|no)$ ]]; then
    block "$bead" "$metadata" "$notes" "policy-malformed" "pr_babysit policy metadata is invalid; needs agent judgment."
    continue
  fi
  [[ "$method_present" == true ]] || method="$legacy_method"
  [[ "$rerun_present" == true ]] || rerun_policy="$legacy_rerun"
  if [[ ! "$method" =~ ^(squash|merge|rebase)$ || ! "$rerun_policy" =~ ^(allowed|no)$ ]]; then
    block "$bead" "$metadata" "$notes" "policy-unavailable" "No valid handoff policy exists; needs agent judgment."
    continue
  fi

  if ! pr_json="$(gh pr view "$pr" --repo "$repo" --json state,headRefOid 2>>"$LOG")"; then
    transition "$bead" "$metadata" "$notes" "pr-data-unavailable" "GitHub PR command failed; retained under patrol." || log "$bead: transition failed"
    continue
  fi
  if ! jq -e 'type == "object" and (.state | type == "string") and (.headRefOid | type == "string")' >/dev/null 2>/dev/null <<<"$pr_json"; then
    transition "$bead" "$metadata" "$notes" "pr-data-malformed" "GitHub PR data was malformed; retained under patrol." || log "$bead: transition failed"
    continue
  fi
  state="$(jq -r .state <<<"$pr_json")"; head="$(jq -r .headRefOid <<<"$pr_json")"
  if [[ "$state" == MERGED ]]; then
    if bd close "$bead" --reason "PR $repo#$pr merged (observed by pr-babysit)." >/dev/null 2>&1; then log "$bead: $repo#$pr already merged; bead closed"; else log "$bead: close failed"; fi
    continue
  fi
  if [[ "$state" == CLOSED ]]; then
    if transition "$bead" "$metadata" "$notes" "closed-unmerged" "PR closed unmerged upstream; needs a decision." && bd update "$bead" --remove-label merge-when-green >/dev/null 2>&1; then log "$bead: $repo#$pr closed unmerged; label removed"; else log "$bead: closed-unmerged mutation failed"; fi
    continue
  fi
  if [[ "$state" != OPEN || ! "$head" =~ ^[0-9a-fA-F]{7,64}$ ]]; then
    transition "$bead" "$metadata" "$notes" "pr-state-or-head-invalid" "GitHub returned an unsafe PR state or head; retained under patrol." || log "$bead: transition failed"
    continue
  fi

  checks_err="$STATE_DIR/gh-checks.err"
  checks="$(gh pr checks "$pr" --repo "$repo" --json name,bucket,link 2>"$checks_err")"; checks_status=$?
  [[ -s "$checks_err" ]] && log "$bead: gh pr checks stderr: $(tr '\n' ' ' <"$checks_err" | cut -c1-200)"
  rm -f "$checks_err"
  if (( checks_status != 0 )) || ! jq -e 'type == "array" and length > 0 and all(.[]; type == "object" and (.name | type == "string") and (.bucket | type == "string") and (.bucket == "pass" or .bucket == "pending" or .bucket == "fail" or .bucket == "skipping" or .bucket == "cancel"))' >/dev/null 2>/dev/null <<<"${checks:-}"; then
    if (( checks_status == 8 )); then
      # gh documents exit 8 as "checks pending" — a real wait state, never a
      # data problem; it must not consume the unavailable-escalation budget.
      transition "$bead" "$metadata" "$notes" "checks-pending-status:$head" "gh reports checks still pending (exit 8); retained under patrol." || log "$bead: transition failed"
      continue
    fi
    checksun_prev="$(jq -r '.pr_babysit_checksun // empty' <<<"$metadata")"
    checksun_n="$(counter_for_head "$checksun_prev" "$head")"
    if (( checksun_n + 1 >= CHECKS_UNAVAILABLE_LIMIT )); then
      block "$bead" "$metadata" "$notes" "checks-unavailable-persistent:$head" "Checks unavailable or absent for $((checksun_n + 1)) consecutive passes; needs agent judgment."
    else
      bd update "$bead" --set-metadata "pr_babysit_checksun=$head:$((checksun_n + 1))" >/dev/null 2>&1 || log "$bead: checks-unavailable counter update failed"
      transition "$bead" "$metadata" "$notes" "checks-unavailable:$head" "GitHub checks data was unavailable, empty, malformed, or unknown; retained under patrol." || log "$bead: transition failed"
    fi
    continue
  fi
  if [[ "$(jq -r '.pr_babysit_checksun // empty' <<<"$metadata")" == "$head":* ]]; then
    bd update "$bead" --unset-metadata pr_babysit_checksun >/dev/null 2>&1 || log "$bead: checks-unavailable counter clear failed"
  fi
  pending="$(jq '[.[] | select(.bucket == "pending")] | length' <<<"$checks")"; failing="$(jq '[.[] | select(.bucket == "fail" or .bucket == "cancel")] | length' <<<"$checks")"
  if (( pending > 0 )); then transition "$bead" "$metadata" "$notes" "waiting:$head" "Checks pending ($pending pending, $failing failing); retained under patrol." || log "$bead: transition failed"; continue; fi

  if (( failing > 0 )); then
    rerun_head="$(jq -r '.pr_babysit_rerun_head // empty' <<<"$metadata")"
    legacy_spent=0; [[ "$notes" == *"flake-rerun-done"* ]] && legacy_spent=1
    if [[ "$rerun_policy" == allowed && "$rerun_head" != "$head" && "$legacy_spent" == 0 ]]; then
      runs="$(jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | (.link // "") | capture("/runs/(?<id>[0-9]+)")?.id // empty' <<<"$checks" | sort -u)"
      if [[ -z "$runs" ]]; then block "$bead" "$metadata" "$notes" "checks-no-rerun-target:$head" "Failing checks have no rerunnable run; needs agent judgment."; continue; fi
      # Reserve before calling GitHub: a crash after reservation conservatively
      # spends the one-rerun budget for this head.
      if ! bd update "$bead" --set-metadata "pr_babysit_rerun_head=$head" >/dev/null 2>&1; then log "$bead: rerun deferred (reservation failed)"; continue; fi
      rerun_ok=0
      while read -r run_id; do [[ -n "$run_id" ]] && gh run rerun "$run_id" --repo "$repo" --failed >>"$LOG" 2>&1 && rerun_ok=1; done <<<"$runs"
      if (( rerun_ok )); then transition "$bead" "$metadata" "$notes" "rerun:$head" "Reran failed checks; waiting for this head." || log "$bead: rerun transition failed"; else block "$bead" "$metadata" "$notes" "rerun-failed:$head" "Rerun command failed; needs agent judgment."; fi
      continue
    fi
    block "$bead" "$metadata" "$notes" "checks-persistent:$head" "Checks still fail after rerun budget; needs agent judgment."
    continue
  fi

  settle_attempted=0
  while :; do
    preflight_out="$(PR_PREFLIGHT_BLOCK_RED_BASE=1 "$PREFLIGHT" "$pr" --repo "$repo" 2>&1)"; preflight_status=$?
    [[ -n "$preflight_out" ]] && sed "s|^|$(date -u +%FT%TZ) [preflight $repo#$pr] |" <<<"$preflight_out" >>"$LOG"
    (( preflight_status != 0 )) || break
    blocks="$(grep -F '[block]' <<<"$preflight_out" || true)"
    genuine="$(grep -vE "$RED_BASE_BLOCK_RE" <<<"$blocks" | grep -vE "$TRANSIENT_BLOCK_RE" || true)"
    if [[ -n "$blocks" && -z "$genuine" ]] && ! grep -qE "$RED_BASE_BLOCK_RE" <<<"$blocks" \
       && (( settle_attempted == 0 && settle_budget > 0 )); then
      settle_attempted=1; settle_budget=$((settle_budget - 1))
      sleep "$SETTLE_DELAY"
      continue
    fi
    break
  done
  if (( preflight_status != 0 )); then
    if [[ -n "$blocks" && -n "$genuine" ]]; then
      block "$bead" "$metadata" "$notes" "preflight-policy:$head" "Preflight reported a non-red-base block; needs agent judgment."
    elif [[ -n "$blocks" ]] && grep -qE "$RED_BASE_BLOCK_RE" <<<"$blocks"; then
      # Red base retains without consuming the transient budget: storms end on
      # their own schedule and must not convert waiting tails into blocks.
      transition "$bead" "$metadata" "$notes" "preflight-red-base:$head" "Base branch CI is red; retained under patrol." || log "$bead: transition failed"
    elif [[ -n "$blocks" ]]; then
      # Transient-only blocks (merge state UNKNOWN/UNSTABLE, checks still
      # pending): GitHub computes these lazily, so wait a bounded number of
      # passes before treating the condition as real.
      transient_prev="$(jq -r '.pr_babysit_transient // empty' <<<"$metadata")"
      transient_n="$(counter_for_head "$transient_prev" "$head")"
      if (( transient_n + 1 >= TRANSIENT_BLOCK_LIMIT )); then
        block "$bead" "$metadata" "$notes" "preflight-transient-persistent:$head" "Merge state stayed transient (UNKNOWN/UNSTABLE/pending) across $((transient_n + 1)) patrol passes; needs agent judgment."
      else
        bd update "$bead" --set-metadata "pr_babysit_transient=$head:$((transient_n + 1))" >/dev/null 2>&1 || log "$bead: transient counter update failed"
        transition "$bead" "$metadata" "$notes" "preflight-transient:$head" "Preflight reported only transient merge-state blocks; retained under patrol." || log "$bead: transition failed"
      fi
    else
      transition "$bead" "$metadata" "$notes" "preflight-unavailable:$head" "Preflight failed without a recognizable block; retained under patrol." || log "$bead: transition failed"
    fi
    continue
  fi
  if ! grep -qE '^\[pass\] Base branch .+ CI is green( \(|$)' <<<"$preflight_out"; then
    transition "$bead" "$metadata" "$notes" "preflight-base-unknown:$head" "Preflight did not explicitly authorize a green base; retained under patrol." || log "$bead: transition failed"
    continue
  fi
  # A fully healthy preflight resets the transient budget: the counter tracks
  # consecutive transient sightings, not lifetime ones.
  if [[ "$(jq -r '.pr_babysit_transient // empty' <<<"$metadata")" == "$head":* ]]; then
    bd update "$bead" --unset-metadata pr_babysit_transient >/dev/null 2>&1 || log "$bead: transient counter clear failed"
  fi
  # Checks and preflight may take time; re-read head and rollup atomically.
  if ! final_json="$(gh pr view "$pr" --repo "$repo" --json state,headRefOid,statusCheckRollup 2>>"$LOG")" || ! jq -e 'type == "object" and .state == "OPEN" and (.headRefOid | type == "string") and (.statusCheckRollup | type == "array") and (.statusCheckRollup | length > 0) and all(.statusCheckRollup[]; ((.__typename == "CheckRun" and .status == "COMPLETED" and (.conclusion == "SUCCESS" or .conclusion == "NEUTRAL" or .conclusion == "SKIPPED")) or (.__typename == "StatusContext" and .state == "SUCCESS")))' >/dev/null 2>/dev/null <<<"${final_json:-}"; then
    transition "$bead" "$metadata" "$notes" "premerge-pr-unavailable:$head" "Could not revalidate PR before merge; retained under patrol." || log "$bead: transition failed"
    continue
  fi
  final_head="$(jq -r .headRefOid <<<"$final_json")"
  if [[ "$final_head" != "$head" ]]; then transition "$bead" "$metadata" "$notes" "head-changed:$head" "PR head changed after checks/preflight; retained under patrol." || log "$bead: transition failed"; continue; fi
  # Patrol-owned retry counters (checksun/transient/rearm) are excluded from
  # the metadata comparison: the patrol legitimately clears them mid-pass, and
  # they carry no merge-authorization meaning.
  if ! current_issue="$(bd show "$bead" --json 2>/dev/null)" || ! jq -e --argjson queued "$item" 'def scrub: (. // {}) | del(.pr_babysit_checksun, .pr_babysit_transient, .pr_babysit_rearm); length == 1 and .[0].id == $queued.id and (. [0].labels | index("merge-when-green")) != null and (. [0].status == $queued.status) and (. [0].assignee == $queued.assignee) and (. [0].external_ref == $queued.external_ref) and (. [0].notes == $queued.notes) and ((.[0].metadata | scrub) == ($queued.metadata | scrub))' >/dev/null 2>/dev/null <<<"${current_issue:-}"; then
    # Surface the skip on the bead (once per head): a persistent mismatch here
    # would otherwise livelock visibly only in the local patrol log.
    transition "$bead" "$metadata" "$notes" "authorization-mismatch:$head" "Bead changed between queue read and merge, or bd was unavailable; merge skipped; retained under patrol." || log "$bead: transition failed"
    log "$bead: merge authorization revoked or unavailable; skipping"
    continue
  fi
  if gh pr merge "$pr" --repo "$repo" "--$method" --match-head-commit "$head" >>"$LOG" 2>&1; then
    if ! after_json="$(gh pr view "$pr" --repo "$repo" --json state 2>>"$LOG")" || ! after_state="$(jq -er '.state | strings' <<<"${after_json:-}" 2>/dev/null)"; then
      transition "$bead" "$metadata" "$notes" "postmerge-unavailable:$head" "Merge returned success but state confirmation failed; retained under patrol." || log "$bead: transition failed"
    elif [[ "$after_state" == MERGED ]]; then
      if bd close "$bead" --reason "PR $repo#$pr merged by pr-babysit ($method)." >/dev/null 2>&1; then log "$bead: MERGED $repo#$pr ($method); bead closed"; else log "$bead: merged PR close failed"; fi
    else
      transition "$bead" "$metadata" "$notes" "merge-queued:$head" "Merge command succeeded but PR remains $after_state; retained under patrol." || log "$bead: transition failed"
    fi
  else
    transition "$bead" "$metadata" "$notes" "merge-failed:$head" "Merge attempt failed; retained under patrol." || log "$bead: transition failed"
  fi
done < <(jq -c '.[]' <<<"$QUEUE")

# --- close-when-quiet: decline offers become closes after a quiet window ----
# A close-when-quiet bead already carries its disposition; the disposing
# agent posted the comment, `pr-close-handoff` only started the clock.  This
# loop never posts a disposition itself — it only notices engagement or, in
# its absence, executes the close once the window elapses.  Any read/parse
# failure retains the bead; nothing here is trusted enough to close on.
close_retain() {
  local bead="$1" metadata="$2" reason="$3" prev n
  prev="$(jq -r '.pr_close_retry // empty' <<<"$metadata")"
  [[ "$prev" =~ ^[0-9]+$ ]] && n="$prev" || n=0
  if (( n + 1 >= CLOSE_RETRY_LIMIT )); then
    if bd update "$bead" --status open --assignee "" --remove-label close-when-quiet --add-label close-blocked \
         --set-metadata "pr_babysit_last_transition=close-data-unavailable-persistent" \
         --append-notes "[pr-babysit $(date -u +%FT%TZ)] transition=close-data-unavailable-persistent — $reason for $((n + 1)) consecutive passes; needs agent judgment." >/dev/null 2>&1; then
      log "$bead: CLOSE-BLOCKED ($reason, $((n + 1)) passes)"
    else
      log "$bead: close-blocked mutation failed; retained under patrol"
    fi
  else
    if bd update "$bead" --set-metadata "pr_close_retry=$((n + 1))" >/dev/null 2>&1; then
      log "$bead: $reason; retained silently ($((n + 1))/$CLOSE_RETRY_LIMIT)"
    else
      log "$bead: close-retry counter update failed; retained under patrol"
    fi
  fi
}

CLOSE_QUEUE="$(bd list --label close-when-quiet --json 2>/dev/null)" || { log "bd unavailable; skipping close-when-quiet"; exit 0; }
if ! jq -e 'type == "array"' >/dev/null 2>/dev/null <<<"$CLOSE_QUEUE"; then log "bd returned malformed close-when-quiet queue data"; exit 0; fi

while read -r item; do
  bead="$(jq -r '.id // empty' <<<"$item")"; ref="$(jq -r '.external_ref // empty' <<<"$item")"; notes="$(jq -r '.notes // empty' <<<"$item")"
  [[ -n "$bead" ]] || { log "close-when-quiet queue item has no id"; continue; }
  metadata_raw="$(jq -c 'if (.metadata? == null) then {} else .metadata end' <<<"$item")"
  if ! jq -e 'type == "object"' >/dev/null 2>/dev/null <<<"$metadata_raw"; then
    # A retain-and-count budget cannot work here: with no readable metadata
    # object there is nowhere to persist the retry counter (each pass would
    # start back at zero), so this escalates immediately instead of looping
    # forever under CLOSE_RETRY_LIMIT.
    if bd update "$bead" --status open --assignee "" --remove-label close-when-quiet --add-label close-blocked \
         --set-metadata "pr_babysit_last_transition=close-metadata-not-object" \
         --append-notes "[pr-babysit $(date -u +%FT%TZ)] transition=close-metadata-not-object — bead metadata is not an object; needs agent judgment." >/dev/null 2>&1; then
      log "$bead: CLOSE-BLOCKED (metadata is not an object)"
    else
      log "$bead: close-blocked mutation failed; retained under patrol"
    fi
    continue
  fi
  metadata="$metadata_raw"

  # A PR can't be in both lanes; a bead that somehow carries both is left for
  # a human rather than guessed at, with a bead-visible note so it surfaces
  # outside the local patrol log too.
  if jq -e '(.labels // []) | index("merge-when-green")' >/dev/null 2>/dev/null <<<"$item"; then
    transition "$bead" "$metadata" "$notes" "dual-lane-labels" "Bead carries both close-when-quiet and merge-when-green; needs agent judgment." || log "$bead: transition failed"
    log "$bead: close-when-quiet and merge-when-green both present; retained (needs agent judgment)"
    continue
  fi

  # Identity: mirrors the merge lane's ref-parse + mismatch guard so a
  # mistyped/missing external_ref can never let this lane act on the wrong PR.
  repo=""; pr=""
  if [[ "$ref" =~ ^gh:([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([1-9][0-9]*)$ ]]; then
    repo="${BASH_REMATCH[1]}"; pr="${BASH_REMATCH[2]}"
  elif [[ "$ref" =~ ^gh-pr-([1-9][0-9]*)$ ]]; then
    repo="gastownhall/beads"; pr="${BASH_REMATCH[1]}"
  elif [[ -z "$ref" ]]; then
    repo="$(jq -r '.pr_babysit_repo // empty' <<<"$metadata")"; pr="$(jq -r '.pr_babysit_pr // empty' <<<"$metadata")"
    if ! valid_repo_pr "$repo" "$pr"; then
      close_retain "$bead" "$metadata" "no valid external_ref or metadata PR identity"
      continue
    fi
  else
    close_retain "$bead" "$metadata" "unparseable external_ref"
    continue
  fi
  meta_repo="$(jq -r '.pr_babysit_repo // empty' <<<"$metadata")"; meta_pr="$(jq -r '.pr_babysit_pr // empty' <<<"$metadata")"
  if { [[ -n "$meta_repo" || -n "$meta_pr" ]]; } && { [[ "$meta_repo" != "$repo" || "$meta_pr" != "$pr" ]]; }; then
    close_retain "$bead" "$metadata" "external_ref and pr_babysit metadata disagree"
    continue
  fi

  close_after="$(jq -r '.pr_close_after // empty' <<<"$metadata")"
  close_head="$(jq -r '.pr_close_head // empty' <<<"$metadata")"
  close_reason="$(jq -r '.pr_close_reason // empty' <<<"$metadata")"
  close_since="$(jq -r '.pr_close_since // empty' <<<"$metadata")"
  if [[ -z "$close_after" || -z "$close_reason" || -z "$close_since" ]] || [[ ! "$close_head" =~ ^[0-9a-fA-F]{7,64}$ ]]; then
    close_retain "$bead" "$metadata" "close-when-quiet metadata is incomplete or malformed"
    continue
  fi
  after_epoch="$(date -u -d "$close_after" +%s 2>/dev/null)" || { close_retain "$bead" "$metadata" "pr_close_after is unparseable"; continue; }
  since_epoch="$(date -u -d "$close_since" +%s 2>/dev/null)" || { close_retain "$bead" "$metadata" "pr_close_since is unparseable"; continue; }

  close_gh_err="$STATE_DIR/gh-close.err"
  pr_json="$(gh pr view "$pr" --repo "$repo" --json state,headRefOid,comments,reviews 2>"$close_gh_err")"; gh_status=$?
  [[ -s "$close_gh_err" ]] && log "$bead: gh pr view (close-when-quiet) stderr: $(tr '\n' ' ' <"$close_gh_err" | cut -c1-200)"
  rm -f "$close_gh_err"
  if (( gh_status != 0 )) || ! jq -e 'type == "object" and (.state | type == "string") and (.headRefOid | type == "string")' >/dev/null 2>/dev/null <<<"${pr_json:-}"; then
    close_retain "$bead" "$metadata" "gh pr view failed or returned malformed data"
    continue
  fi
  if [[ -n "$(jq -r '.pr_close_retry // empty' <<<"$metadata")" ]]; then
    bd update "$bead" --unset-metadata pr_close_retry >/dev/null 2>&1 || log "$bead: close-retry counter clear failed"
  fi

  state="$(jq -r .state <<<"$pr_json")"; head="$(jq -r .headRefOid <<<"$pr_json")"
  if [[ "$state" == MERGED || "$state" == CLOSED ]]; then
    if bd close "$bead" --reason "PR $repo#$pr $state upstream (observed by pr-babysit close-when-quiet)." >/dev/null 2>&1; then
      log "$bead: $repo#$pr already $state; close-when-quiet bead closed"
    else
      log "$bead: close failed (close-when-quiet, $state)"
    fi
    continue
  fi
  if [[ "$state" != OPEN || ! "$head" =~ ^[0-9a-fA-F]{7,64}$ ]]; then
    close_retain "$bead" "$metadata" "GitHub returned an unsafe PR state or head"
    continue
  fi
  # Comments/reviews must be structurally trustworthy before the engagement
  # check relies on them: present, arrays, and every element carrying a
  # string timestamp. Anything else fails closed (retained, never a close).
  if ! jq -e 'has("comments") and has("reviews") and (.comments | type == "array") and (.reviews | type == "array") and all((.comments + .reviews)[]; type == "object" and ((.createdAt // .submittedAt) | type == "string"))' >/dev/null 2>/dev/null <<<"$pr_json"; then
    close_retain "$bead" "$metadata" "comments/reviews data unreadable"
    continue
  fi

  # Engagement: a moved head, or any comment/review timestamped at/after the
  # disposition, returns the bead to humans.  Per-author attribution isn't
  # tracked, so any post-disposition activity counts — the safer default.
  # A timestamp that fails to parse counts as engagement too: unreadable
  # activity must never be silently treated as no activity.
  engaged=0; why=""
  if [[ "$head" != "$close_head" ]]; then
    engaged=1; why="PR head moved since the disposition ($close_head -> $head)"
  else
    ts_list="$(jq -r '((.comments + .reviews)[]) | (.createdAt // .submittedAt)' <<<"$pr_json" 2>/dev/null)"; ts_status=$?
    if (( ts_status != 0 )); then
      close_retain "$bead" "$metadata" "could not extract comment/review timestamps"
      continue
    fi
    while IFS= read -r ts; do
      [[ -n "$ts" ]] || continue
      ts_epoch="$(date -u -d "$ts" +%s 2>/dev/null)"
      if [[ -z "$ts_epoch" ]]; then
        engaged=1; why="unparseable activity timestamp treated as engagement ($ts)"; break
      fi
      if (( ts_epoch >= since_epoch )); then engaged=1; why="new comment or review since the disposition ($ts)"; break; fi
    done <<<"$ts_list"
  fi
  if (( engaged )); then
    if bd update "$bead" --status open --assignee "" --remove-label close-when-quiet \
         --set-metadata "pr_babysit_last_transition=contributor-engaged:$head" \
         --unset-metadata pr_close_retry --unset-metadata pr_close_after --unset-metadata pr_close_head \
         --unset-metadata pr_close_since --unset-metadata pr_close_reason \
         --append-notes "[pr-babysit $(date -u +%FT%TZ)] transition=contributor-engaged:$head — $why; returned to humans." >/dev/null 2>&1; then
      log "$bead: contributor engaged; returned to humans ($why)"
    else
      log "$bead: contributor-engaged mutation failed; retained under patrol"
    fi
    continue
  fi

  if (( $(date -u +%s) < after_epoch )); then
    continue
  fi

  # Re-read the bead immediately before acting: never close a PR against a
  # stale authorization snapshot from the queue read at the top of this pass.
  if ! current_issue="$(bd show "$bead" --json 2>/dev/null)" || ! jq -e --argjson queued "$item" '
      length == 1
      and .[0].id == $queued.id
      and (.[0].labels | index("close-when-quiet")) != null
      and (.[0].metadata.pr_close_after == $queued.metadata.pr_close_after)
      and (.[0].metadata.pr_close_head == $queued.metadata.pr_close_head)
      and (.[0].metadata.pr_close_reason == $queued.metadata.pr_close_reason)
      and (.[0].metadata.pr_babysit_pr == $queued.metadata.pr_babysit_pr)
    ' >/dev/null 2>/dev/null <<<"${current_issue:-}"; then
    close_retain "$bead" "$metadata" "bead changed between queue read and close, or bd was unavailable; close skipped"
    continue
  fi

  if gh pr close "$pr" --repo "$repo" --comment "$close_reason" >>"$LOG" 2>&1; then
    if bd close "$bead" --reason "PR $repo#$pr closed by pr-babysit after a quiet window: $close_reason" >/dev/null 2>&1; then
      log "$bead: CLOSED $repo#$pr after quiet window; bead closed"
    else
      log "$bead: PR closed but bead close failed; retained under patrol"
    fi
  else
    close_retain "$bead" "$metadata" "gh pr close failed"
  fi
done < <(jq -c '.[]' <<<"$CLOSE_QUEUE")
