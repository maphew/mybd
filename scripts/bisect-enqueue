#!/usr/bin/env bash
# bisect-enqueue - manually queue a red-base bisect job on a base-red bead.
#
# The base-red lane auto-queues (pr-babysit marks bisect_state=queued when it
# raises a bead). Use this only to (re)queue by hand or to override the command.
#
# Usage:
#   scripts/bisect-enqueue <bd-id> [bisect command...]
#
# The bead must be an open base-red bead carrying pr_babysit_red_base metadata;
# bisect-next resolves the good/bad commits itself from that key.
set -euo pipefail
. "$(dirname "$0")/_tri-lib.sh"
tri_require bd jq

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; }
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
[[ $# -ge 1 ]] || { usage >&2; exit 2; }

BD_ID="$(tri_resolve_bd_id "$1")"; shift
CMD="${*:-}"

issue_json="$(bd show "$BD_ID" --json)" || tri_die "cannot read $BD_ID"
status="$(jq -r '.[0].status // empty' <<<"$issue_json")"
key="$(jq -r '.[0].metadata.pr_babysit_red_base // empty' <<<"$issue_json")"

[[ "$status" == "open" ]] || tri_die "$BD_ID is $status, not open"
[[ -n "$key" ]] || tri_die "$BD_ID has no pr_babysit_red_base metadata; not a base-red bead"

args=(update "$BD_ID"
  --set-metadata bisect_state=queued
  --set-metadata bisect_result=
  --set-metadata bisect_started_at=
  --set-metadata bisect_finished_at=
  --set-metadata bisect_culprit=
  --set-metadata bisect_culprit_subject=)
[[ -n "$CMD" ]] && args+=(--set-metadata "bisect_cmd=$CMD")
bd "${args[@]}" >/dev/null

tri_log_note "$BD_ID" "bisect queued (manual): base=$key${CMD:+ cmd=$CMD}"
echo "Queued bisect for $BD_ID"
tri_kv "base" "$key"
tri_kv "command" "${CMD:-(bead bisect_cmd or 'make test')}"
