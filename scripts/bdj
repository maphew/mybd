#!/usr/bin/env bash
# bdj — run `bd <args> --json` and normalize stdout to a JSON ARRAY.
#
# Why (retro F-004): bd's --json output shape varies by command — some emit a
# single object, some an array, some nothing on empty results. Sessions
# repeatedly wrote `jq '.[0]'` against an object or `jq '.id'` against an
# array and failed mid-pipeline. bdj makes the shape uniform:
#
#   - array output      -> passed through unchanged
#   - object output     -> wrapped as a one-element array
#   - empty output      -> []
#
# Usage: scripts/bdj <bd-args...>        # do NOT pass --json; bdj adds it
# House rule (retro F-011): for any COUNTING, pass `-n 0` (unlimited) —
# bd listing commands default to a silent 100-row cap.

set -euo pipefail

for a in "$@"; do
  if [[ "$a" == "--json" ]]; then
    echo "bdj: do not pass --json; bdj adds it (repeated single-value flags are last-one-wins)" >&2
    exit 2
  fi
done

out="$(bd "$@" --json)" || exit $?

if [[ -z "${out//[[:space:]]/}" ]]; then
  printf '[]\n'
  exit 0
fi

printf '%s' "$out" | jq 'if type == "array" then . else [.] end'
