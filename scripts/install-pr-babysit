#!/usr/bin/env bash
# Install and enable the pr-babysit systemd user timer on this machine.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UNIT_DIR"
root_escaped="$(printf '%s' "$ROOT" | sed 's/[\\&|]/\\&/g')"
sed "s|@ROOT@|$root_escaped|g" "$ROOT/scripts/systemd/pr-babysit.service" >"$UNIT_DIR/pr-babysit.service"
install -m 0644 "$ROOT/scripts/systemd/pr-babysit.timer" "$UNIT_DIR/pr-babysit.timer"
systemctl --user daemon-reload
systemctl --user enable --now pr-babysit.timer
systemctl --user list-timers pr-babysit.timer --no-pager
