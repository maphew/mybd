#!/usr/bin/env bash
# test-pr-review-gate - smoke-test the PreToolUse gate, in the style of
# scripts/test-git-hooks.
#
# A hook that blocks `gh pr create` can stop real work from a phone, so the
# allow cases matter at least as much as the deny case: everything that is not
# an unreviewed upstream PR must pass through untouched.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATE="$ROOT/scripts/pr-review-gate"
CLAUDE_FIXTURE="$ROOT/scripts/fixtures/claude-pretooluse-bash.json"
CODEX_FIXTURE="$ROOT/scripts/fixtures/codex-pretooluse-shell.json"
# Resolve the log dir the way the gate does, so a run from a linked worktree
# plants its fixture where the gate will actually look.
_common="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[[ -n "$_common" ]] && ROOT="$(dirname "$_common")"
REVIEW_DIR="$ROOT/.worktrees/.review-logs"

pass=0; fail=0
have_codex=1; command -v codex >/dev/null 2>&1 || have_codex=0

# A throwaway repo with one commit, so HEAD is a real sha we control.
tmp="$(mktemp -d "${TMPDIR:-/tmp}/prgate.XXXXXX")"
trap 'rm -rf "$tmp" "$tmp-other"; [[ -n "${planted:-}" ]] && rm -f "$REVIEW_DIR/$planted.md" "$REVIEW_DIR/$planted.redteam.json"' EXIT
# The initial commit's tree contains this run's own tmp path, so the sha is
# unique per PROCESS, not just per repo. Same-second empty commits hash
# identically ACROSS concurrent runs of this suite too, and colliding shas
# made parallel runs race each other through the shared sha-keyed fixture
# files in REVIEW_DIR (red-team finding RT-004).
git -C "$tmp" init -q
printf '%s\n' "$tmp" > "$tmp/.marker"
git -C "$tmp" add .marker
git -C "$tmp" -c user.email=t@t -c user.name=t commit -q -m init
git -C "$tmp" remote add origin git@github.com:maphew/beads.git
sha="$(git -C "$tmp" rev-parse HEAD)"

# A second checkout with nothing to do with beads, for the case where only an
# explicit -R/--repo reveals that the PR targets upstream. Its marker differs
# from the first repo's: an $other whose HEAD collided with the reviewed $sha
# silently turned every deny case here into an allow.
other="$tmp-other"
mkdir -p "$other"
git -C "$other" init -q
printf '%s\n' "$other" > "$other/.marker"
git -C "$other" add .marker
git -C "$other" -c user.email=t@t -c user.name=t commit -q -m init-unrelated
git -C "$other" remote add origin git@github.com:someone/unrelated.git

run() { # run <cmd> <cwd> [fixture] -> exit code
  jq --arg c "$1" --arg d "$2" '.tool_input.command=$c | .cwd=$d' "${3:-$CLAUDE_FIXTURE}" \
    | "$GATE" >/dev/null 2>&1
  echo $?
}

check() { # check <label> <expected> <actual>
  if [[ "$2" == "$3" ]]; then
    printf '  ok    %s\n' "$1"; pass=$((pass+1))
  else
    printf '  FAIL  %s (want exit %s, got %s)\n' "$1" "$2" "$3"; fail=$((fail+1))
  fi
}

# plant_redteam <sha> <base> [verdict] - a minimal passing (by default) red-team
# verdict fixture, the companion to the .md fixture the gate now also requires.
# head, findings, and rounds are all mandatory: the gate rejects anything
# scripts/red-team could not have written (RT-002).
plant_redteam() {
  printf '{"head":"%s","base":"%s","verdict":"%s","rounds":1,"open_p0p1":0,"findings":[]}\n' \
    "$1" "$2" "${3:-pass}" > "$REVIEW_DIR/$1.redteam.json"
}

echo "pr-review-gate:"

# Pass-through: things the gate must never touch.
check "unrelated command"        0 "$(run 'ls -la' "$tmp")"
check "gh pr view"               0 "$(run 'gh pr view 123 --repo gastownhall/beads' "$tmp")"
check "gh pr create, other repo" 0 "$(run 'gh pr create --repo maphew/mybd --title x' "$tmp")"
check "gh pr create, -R other"   0 "$(run 'gh pr create -R maphew/mybd --title x' "$tmp")"
check "substring, not a command" 0 "$(run 'echo "how to gh pr create"' "$tmp")"
check "quoted, not a command"    0 "$(run "printf 'run gh pr create --repo gastownhall/beads now'" "$tmp")"
check "both skip hatches honored" 0 "$(run 'MYBD_SKIP_XVENDOR=1 MYBD_SKIP_REDTEAM=1 gh pr create --repo gastownhall/beads' "$tmp")"
check "Codex fixture keeps both skip hatches" 0 "$(run 'MYBD_SKIP_XVENDOR=1 MYBD_SKIP_REDTEAM=1 gh pr create --repo gastownhall/beads' "$tmp" "$CODEX_FIXTURE")"
unknown_out="$(jq -nc '{hook_event_name:"PreToolUse",tool_name:"Bash",tool_input:{command:["gh","pr","create"]}}' | "$GATE" 2>&1)"; unknown_rc=$?
if [[ $unknown_rc -eq 0 && "$unknown_out" == *"WARNING: unrecognized Bash PreToolUse payload"* ]]; then
  check "unknown Bash payload warns visibly" 0 0
else
  printf '  FAIL  unknown Bash payload behavior (rc=%s out=%s)\n' "$unknown_rc" "$unknown_out"; fail=$((fail+1))
fi
for bad_payload in \
  '{not-json' \
  '{"hook_event_name":"PreToolUse","tool_input":{"command":"gh pr create"}}' \
  '{"hook_event_name":"PreToolUse","tool_name":null,"tool_input":{"command":"gh pr create"}}'; do
  bad_out="$(printf '%s' "$bad_payload" | "$GATE" 2>&1)"; bad_rc=$?
  if [[ $bad_rc -eq 0 && "$bad_out" == *"WARNING: unrecognized Bash PreToolUse payload"* ]]; then
    check "malformed/partial payload warns visibly" 0 0
  else
    printf '  FAIL  malformed/partial payload behavior (rc=%s out=%s)\n' "$bad_rc" "$bad_out"; fail=$((fail+1))
  fi
done
renamed_shell_out="$(jq -nc '{hook_event_name:"PreToolUse",tool_name:"shell",tool_input:{command:"gh pr create"}}' | "$GATE" 2>&1)"; renamed_shell_rc=$?
if [[ $renamed_shell_rc -eq 0 && "$renamed_shell_out" == *"WARNING: unrecognized Bash PreToolUse payload"* ]]; then
  check "unknown tool carrying a shell command warns" 0 0
else
  printf '  FAIL  renamed-shell payload behavior (rc=%s out=%s)\n' "$renamed_shell_rc" "$renamed_shell_out"; fail=$((fail+1))
fi
nonbash_out="$(jq -nc '{hook_event_name:"PreToolUse",tool_name:"Read",tool_input:{path:"x"}}' | "$GATE" 2>&1)"; nonbash_rc=$?
if [[ $nonbash_rc -eq 0 && -z "$nonbash_out" ]]; then
  check "known non-Bash silently allows" 0 0
else
  printf '  FAIL  known non-Bash behavior (rc=%s out=%s)\n' "$nonbash_rc" "$nonbash_out"; fail=$((fail+1))
fi
mkdir -p "$tmp/missing-gate-lib"
cp -f "$GATE" "$tmp/missing-gate-lib/pr-review-gate"
missing_lib_out="$(jq --arg c 'gh pr create --repo gastownhall/beads' '.tool_input.command=$c' "$CODEX_FIXTURE" | "$tmp/missing-gate-lib/pr-review-gate" 2>&1)"; missing_lib_rc=$?
if [[ $missing_lib_rc -eq 0 && "$missing_lib_out" == *"missing scripts/lib/hook-payload.sh"* ]]; then
  check "pr-review-gate reports a missing payload adapter honestly" 0 0
else
  printf '  FAIL  missing payload adapter behavior (rc=%s out=%s)\n' "$missing_lib_rc" "$missing_lib_out"; fail=$((fail+1))
fi

if (( have_codex )); then
  # Deny: upstream PR, no review log for HEAD.
  check "unreviewed, --repo named"  2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  check "Codex fixture, unreviewed named" 2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp" "$CODEX_FIXTURE")"
  check "unreviewed, -R named"      2 "$(run 'gh pr create -R gastownhall/beads --title x' "$tmp")"
  # The bypass -R has to close: an upstream PR opened from a checkout whose
  # remotes are NOT beads, where remote inference alone would wave it through.
  check "-R upstream from elsewhere" 2 "$(run 'gh pr create -R gastownhall/beads --title x' "$other")"
  check "unreviewed, inferred repo" 2 "$(run 'gh pr create --title x' "$tmp")"
  check "unreviewed, cd prefix"     2 "$(run "cd $tmp && gh pr create --repo gastownhall/beads" "$ROOT")"

  # Skipping only the xvendor half still leaves the red-team half unsatisfied
  # (nothing planted at all here) - the dual gate must still block.
  check "skip xvendor alone still blocked" 2 "$(run 'MYBD_SKIP_XVENDOR=1 gh pr create --repo gastownhall/beads --title x' "$tmp")"

  # RT-001 regression: the hatch is =1 exactly, not any value starting with 1.
  check "skip value 10 is not the hatch" 2 "$(run 'MYBD_SKIP_XVENDOR=10 MYBD_SKIP_REDTEAM=10 gh pr create --repo gastownhall/beads --title x' "$tmp")"

  # Cross-vendor review regression: hatch text that is not an env-style
  # prefix on the gh segment itself must not disarm the gate.
  check "hatch after the gh word ignored" 2 "$(run 'gh pr create --repo gastownhall/beads --title x MYBD_SKIP_XVENDOR=1 MYBD_SKIP_REDTEAM=1' "$tmp")"
  check "hatch in another segment ignored" 2 "$(run 'echo MYBD_SKIP_XVENDOR=1 MYBD_SKIP_REDTEAM=1; gh pr create --repo gastownhall/beads --title x' "$tmp")"
  check "hatch as variable suffix ignored" 2 "$(run 'FOOMYBD_SKIP_XVENDOR=1 FOOMYBD_SKIP_REDTEAM=1 gh pr create --repo gastownhall/beads --title x' "$tmp")"

  # Allow: a review log AND a passing red-team verdict for exactly this HEAD,
  # against the base being targeted.
  mkdir -p "$REVIEW_DIR"
  planted="$sha"
  printf '# fixture\n\n- base: `main`\n' > "$REVIEW_DIR/$sha.md"
  plant_redteam "$sha" main
  check "reviewed HEAD passes"      0 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  check "Codex fixture, reviewed HEAD passes" 0 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp" "$CODEX_FIXTURE")"
  check "reviewed via cd prefix"    0 "$(run "cd $tmp && gh pr create --repo gastownhall/beads" "$ROOT")"
  check "reviewed, quoted repo"     0 "$(run 'gh pr create --repo "gastownhall/beads" --title x' "$tmp")"

  # The log covers a commit AND a base. A review taken against one base says
  # nothing about the same sha proposed against another.
  check "base mismatch re-arms"     2 "$(run 'gh pr create --repo gastownhall/beads --base release' "$tmp")"
  check "matching base passes"      0 "$(run 'gh pr create --repo gastownhall/beads --base main' "$tmp")"

  # An explicit --head names the proposal; a reviewed cwd must not vouch for it.
  git -C "$tmp" branch -q other-work
  git -C "$tmp" -c user.email=t@t -c user.name=t commit -q --allow-empty -m diverge
  git -C "$tmp" branch -qf other-work HEAD
  git -C "$tmp" reset -q --hard "$sha"
  check "--head outvotes cwd HEAD"  2 "$(run 'gh pr create --repo gastownhall/beads --head me:other-work' "$tmp")"
  check "-H outvotes cwd HEAD"      2 "$(run 'gh pr create --repo gastownhall/beads -H me:other-work' "$tmp")"

  # `gh pr new` is an alias for `gh pr create`; the gate must know both.
  check "gh pr new is gated"        2 "$(run 'gh pr new --repo gastownhall/beads --head me:other-work' "$tmp")"
  check "gh pr new, reviewed head"  0 "$(run 'gh pr new --repo gastownhall/beads --title x' "$tmp")"

  # gh takes its target from GH_REPO too, so an unrelated checkout plus that
  # assignment is still an upstream PR.
  check "GH_REPO from elsewhere"    2 "$(run 'GH_REPO=gastownhall/beads gh pr create --title x' "$other")"

  # An explicit head that resolves nowhere locally cannot be checked, and gh
  # can still open the PR from the remote branch — so stop rather than fall
  # back to the cwd's (reviewed) HEAD.
  check "unresolvable --head blocks" 2 "$(run 'gh pr create --repo gastownhall/beads --head me:only-on-github' "$tmp")"

  # `cd` names where gh actually runs; the directory it started in must not
  # vouch for the one it moved to.
  check "cd into unreviewed blocks" 2 "$(run "cd $other && gh pr create --repo gastownhall/beads" "$tmp")"

  # A log with no base line records nothing about which diff was read.
  printf '' > "$REVIEW_DIR/$sha.md"
  check "empty log rejected"        2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  printf '# truncated\n' > "$REVIEW_DIR/$sha.md"
  check "log without base rejected" 2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  printf '# fixture\n\n- base: `main`\n' > "$REVIEW_DIR/$sha.md"

  # gh honours branch.<current>.gh-merge-base when --base is omitted.
  git -C "$tmp" config branch.master.gh-merge-base release 2>/dev/null
  git -C "$tmp" config "branch.$(git -C "$tmp" rev-parse --abbrev-ref HEAD).gh-merge-base" release
  check "configured merge-base honored" 2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  git -C "$tmp" config --unset "branch.$(git -C "$tmp" rev-parse --abbrev-ref HEAD).gh-merge-base"

  # gh accepts [HOST/]OWNER/REPO; the host must not disguise the target.
  check "host-qualified --repo"     2 "$(run 'gh pr create --repo github.com/gastownhall/beads --head me:other-work' "$other")"
  check "host-qualified GH_REPO"    2 "$(run 'GH_REPO=github.com/gastownhall/beads gh pr create --title x' "$other")"

  # Chained creations cannot have their flags attributed; ask for one per call.
  check "chained creations blocked" 2 "$(run 'gh pr create --repo maphew/mybd; gh pr create --repo gastownhall/beads' "$tmp")"

  # A stale local branch must not vouch for the remote tip gh would push from.
  git -C "$tmp" update-ref "refs/remotes/origin/other-work" "$(git -C "$tmp" rev-parse other-work)"
  git -C "$tmp" branch -qf other-work "$sha"
  check "remote tip outranks local" 2 "$(run 'gh pr create --repo gastownhall/beads --head me:other-work' "$tmp")"

  # A moved HEAD must re-arm: the log vouches for a commit, not a branch.
  git -C "$tmp" -c user.email=t@t -c user.name=t commit -q --allow-empty -m second
  check "amended HEAD re-arms gate" 2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
else
  echo "  skip  deny cases (codex not on PATH; the gate stands down by design)"
  check "no codex means no block"   0 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
fi

echo
echo "$pass passed, $fail failed"
[[ "$fail" -eq 0 ]]
