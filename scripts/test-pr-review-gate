#!/usr/bin/env bash
# test-pr-review-gate - smoke-test the PreToolUse gate, in the style of
# scripts/test-git-hooks.
#
# A hook that blocks `gh pr create` can stop real work from a phone, so the
# allow cases matter at least as much as the deny case: everything that is not
# an unreviewed upstream PR must pass through untouched.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATE="$ROOT/scripts/pr-review-gate"
# Resolve the log dir the way the gate does, so a run from a linked worktree
# plants its fixture where the gate will actually look.
_common="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[[ -n "$_common" ]] && ROOT="$(dirname "$_common")"
REVIEW_DIR="$ROOT/.worktrees/.review-logs"

pass=0; fail=0
have_codex=1; command -v codex >/dev/null 2>&1 || have_codex=0

# A throwaway repo with one commit, so HEAD is a real sha we control.
tmp="$(mktemp -d "${TMPDIR:-/tmp}/prgate.XXXXXX")"
trap 'rm -rf "$tmp" "$tmp-other"; [[ -n "${planted:-}" ]] && rm -f "$REVIEW_DIR/$planted.md"' EXIT
git -C "$tmp" init -q
git -C "$tmp" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init
git -C "$tmp" remote add origin git@github.com:maphew/beads.git
sha="$(git -C "$tmp" rev-parse HEAD)"

# A second checkout with nothing to do with beads, for the case where only an
# explicit -R/--repo reveals that the PR targets upstream.
#
# Its commit message must differ from the first repo's. Two empty-tree,
# no-parent commits made in the same second by the same author hash
# identically, and an $other whose HEAD collided with the reviewed $sha
# silently turned every deny case here into an allow.
other="$tmp-other"
mkdir -p "$other"
git -C "$other" init -q
git -C "$other" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init-unrelated
git -C "$other" remote add origin git@github.com:someone/unrelated.git

run() { # run <cmd> <cwd> -> exit code
  jq -nc --arg c "$1" --arg d "$2" \
    '{hook_event_name:"PreToolUse",tool_name:"Bash",cwd:$d,tool_input:{command:$c}}' \
    | "$GATE" >/dev/null 2>&1
  echo $?
}

check() { # check <label> <expected> <actual>
  if [[ "$2" == "$3" ]]; then
    printf '  ok    %s\n' "$1"; pass=$((pass+1))
  else
    printf '  FAIL  %s (want exit %s, got %s)\n' "$1" "$2" "$3"; fail=$((fail+1))
  fi
}

echo "pr-review-gate:"

# Pass-through: things the gate must never touch.
check "unrelated command"        0 "$(run 'ls -la' "$tmp")"
check "gh pr view"               0 "$(run 'gh pr view 123 --repo gastownhall/beads' "$tmp")"
check "gh pr create, other repo" 0 "$(run 'gh pr create --repo maphew/mybd --title x' "$tmp")"
check "gh pr create, -R other"   0 "$(run 'gh pr create -R maphew/mybd --title x' "$tmp")"
check "substring, not a command" 0 "$(run 'echo "how to gh pr create"' "$tmp")"
check "quoted, not a command"    0 "$(run "printf 'run gh pr create --repo gastownhall/beads now'" "$tmp")"
check "escape hatch honored"     0 "$(run 'MYBD_SKIP_XVENDOR=1 gh pr create --repo gastownhall/beads' "$tmp")"

if (( have_codex )); then
  # Deny: upstream PR, no review log for HEAD.
  check "unreviewed, --repo named"  2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  check "unreviewed, -R named"      2 "$(run 'gh pr create -R gastownhall/beads --title x' "$tmp")"
  # The bypass -R has to close: an upstream PR opened from a checkout whose
  # remotes are NOT beads, where remote inference alone would wave it through.
  check "-R upstream from elsewhere" 2 "$(run 'gh pr create -R gastownhall/beads --title x' "$other")"
  check "unreviewed, inferred repo" 2 "$(run 'gh pr create --title x' "$tmp")"
  check "unreviewed, cd prefix"     2 "$(run "cd $tmp && gh pr create --repo gastownhall/beads" "$ROOT")"

  # Allow: a review log for exactly this HEAD, against the base being targeted.
  mkdir -p "$REVIEW_DIR"
  planted="$sha"
  printf '# fixture\n\n- base: `main`\n' > "$REVIEW_DIR/$sha.md"
  check "reviewed HEAD passes"      0 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  check "reviewed via cd prefix"    0 "$(run "cd $tmp && gh pr create --repo gastownhall/beads" "$ROOT")"
  check "reviewed, quoted repo"     0 "$(run 'gh pr create --repo "gastownhall/beads" --title x' "$tmp")"

  # The log covers a commit AND a base. A review taken against one base says
  # nothing about the same sha proposed against another.
  check "base mismatch re-arms"     2 "$(run 'gh pr create --repo gastownhall/beads --base release' "$tmp")"
  check "matching base passes"      0 "$(run 'gh pr create --repo gastownhall/beads --base main' "$tmp")"

  # An explicit --head names the proposal; a reviewed cwd must not vouch for it.
  git -C "$tmp" branch -q other-work
  git -C "$tmp" -c user.email=t@t -c user.name=t commit -q --allow-empty -m diverge
  git -C "$tmp" branch -qf other-work HEAD
  git -C "$tmp" reset -q --hard "$sha"
  check "--head outvotes cwd HEAD"  2 "$(run 'gh pr create --repo gastownhall/beads --head me:other-work' "$tmp")"
  check "-H outvotes cwd HEAD"      2 "$(run 'gh pr create --repo gastownhall/beads -H me:other-work' "$tmp")"

  # `gh pr new` is an alias for `gh pr create`; the gate must know both.
  check "gh pr new is gated"        2 "$(run 'gh pr new --repo gastownhall/beads --head me:other-work' "$tmp")"
  check "gh pr new, reviewed head"  0 "$(run 'gh pr new --repo gastownhall/beads --title x' "$tmp")"

  # gh takes its target from GH_REPO too, so an unrelated checkout plus that
  # assignment is still an upstream PR.
  check "GH_REPO from elsewhere"    2 "$(run 'GH_REPO=gastownhall/beads gh pr create --title x' "$other")"

  # An explicit head that resolves nowhere locally cannot be checked, and gh
  # can still open the PR from the remote branch — so stop rather than fall
  # back to the cwd's (reviewed) HEAD.
  check "unresolvable --head blocks" 2 "$(run 'gh pr create --repo gastownhall/beads --head me:only-on-github' "$tmp")"

  # `cd` names where gh actually runs; the directory it started in must not
  # vouch for the one it moved to.
  check "cd into unreviewed blocks" 2 "$(run "cd $other && gh pr create --repo gastownhall/beads" "$tmp")"

  # A log with no base line records nothing about which diff was read.
  printf '' > "$REVIEW_DIR/$sha.md"
  check "empty log rejected"        2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  printf '# truncated\n' > "$REVIEW_DIR/$sha.md"
  check "log without base rejected" 2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  printf '# fixture\n\n- base: `main`\n' > "$REVIEW_DIR/$sha.md"

  # gh honours branch.<current>.gh-merge-base when --base is omitted.
  git -C "$tmp" config branch.master.gh-merge-base release 2>/dev/null
  git -C "$tmp" config "branch.$(git -C "$tmp" rev-parse --abbrev-ref HEAD).gh-merge-base" release
  check "configured merge-base honored" 2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
  git -C "$tmp" config --unset "branch.$(git -C "$tmp" rev-parse --abbrev-ref HEAD).gh-merge-base"

  # A moved HEAD must re-arm: the log vouches for a commit, not a branch.
  git -C "$tmp" -c user.email=t@t -c user.name=t commit -q --allow-empty -m second
  check "amended HEAD re-arms gate" 2 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
else
  echo "  skip  deny cases (codex not on PATH; the gate stands down by design)"
  check "no codex means no block"   0 "$(run 'gh pr create --repo gastownhall/beads --title x' "$tmp")"
fi

echo
echo "$pass passed, $fail failed"
[[ "$fail" -eq 0 ]]
