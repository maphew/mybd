#!/usr/bin/env bash
# bisect-next - run one queued red-base bisect job and file the culprit commit.
#
# Zero-token, fail-closed companion to the pr-babysit base-red lane. When
# pr-babysit raises a `base-red` P0 bead it also marks bisect_state=queued on
# that bead. This runner picks up one such job, determines the last-green and
# first-red commits of the affected base branch, confirms the failure is
# locally reproducible (oracle guard), bisects with `git bisect run`, and
# annotates the SAME base-red bead with the culprit commit. It NEVER changes
# the bead's status, labels, claim, or assignee — the base-red lane owns that
# lifecycle; this lane only adds bisect_* metadata and one note.
#
# Usage:
#   scripts/bisect-next [bd-id]        # a specific queued base-red bead, else FIFO
#
# Environment:
#   BISECT_CMD=make test          # override the reproduction command
#   BISECT_TIMEOUT=90m            # whole-run cap around git bisect
#   BISECT_STEP_TIMEOUT=45m       # per-step (per suite run) cap
#   BISECT_WORKTREE_BASE=<root>/.worktrees/beads
#   BISECT_LOG_DIR=<worktree-base>/.bisect-logs
#   BISECT_KEEP_WORKTREE=failed   # always | failed | never
#   BISECT_MAX_GOOD_SCAN=50       # how many recent successful CI runs to scan for a good SHA
#
# Hermetic test hook (used by scripts/test-bisect-lane; do NOT set in prod):
#   BISECT_JOB_FILE=<path>        # read job (repo/branch/bad/good/cmd) as KEY=VALUE
#                                 # lines and write results back there, bypassing
#                                 # bd, gh, and the upstream fetch entirely.
#   BISECT_REPO=<path>            # git repo to bisect in job-file mode.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SELF_DIR/_tri-lib.sh"

usage() { sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; }
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ $# -gt 1 ]]; then usage >&2; exit 2; fi

JOB_FILE="${BISECT_JOB_FILE:-}"

# --------------------------------------------------------------------------
# Shared knobs
# --------------------------------------------------------------------------
BISECT_TIMEOUT="${BISECT_TIMEOUT:-90m}"
BISECT_STEP_TIMEOUT="${BISECT_STEP_TIMEOUT:-45m}"
BISECT_WORKTREE_BASE="${BISECT_WORKTREE_BASE:-$TRI_PROJECT_ROOT/.worktrees/beads}"
BISECT_LOG_DIR="${BISECT_LOG_DIR:-$BISECT_WORKTREE_BASE/.bisect-logs}"
BISECT_KEEP_WORKTREE="${BISECT_KEEP_WORKTREE:-failed}"
BISECT_MAX_GOOD_SCAN="${BISECT_MAX_GOOD_SCAN:-50}"

case "$BISECT_KEEP_WORKTREE" in
  always | failed | never) ;;
  *) tri_die "unknown BISECT_KEEP_WORKTREE=$BISECT_KEEP_WORKTREE (expected always, failed, never)" ;;
esac

# run_cmd DIR CMD LOG  -> exit code of CMD run in DIR, output appended to LOG,
# wrapped in a per-step timeout when `timeout` is available.
# The script deliberately runs WITHOUT errexit (set -uo pipefail only); it
# manages control flow with explicit exit-code checks. Never toggle `set -e`
# here — enabling it would abort the run the moment an oracle guard command
# legitimately returns nonzero.
run_cmd() {
  local dir="$1" cmd="$2" logf="$3" rc=0
  if command -v timeout >/dev/null 2>&1; then
    (cd "$dir" && timeout "$BISECT_STEP_TIMEOUT" bash -lc "$cmd") >>"$logf" 2>&1 || rc=$?
  else
    (cd "$dir" && bash -lc "$cmd") >>"$logf" 2>&1 || rc=$?
  fi
  return "$rc"
}

# Map a raw command exit code to a bisect verdict: good | bad | skip.
# A clean pass (0) is good; a genuine test failure is bad; but a timeout (124),
# an unrunnable command (125-127), or a signal (>=128) is NOT a reproduction —
# it must SKIP, never count as "bad". Treating a timed-out or un-buildable
# commit as bad is exactly how a bisect fingers the wrong commit.
classify_rc() {
  case "$1" in
    0) echo good ;;
    124 | 125 | 126 | 127) echo skip ;;
    *) if [[ "$1" -ge 128 ]]; then echo skip; else echo bad; fi ;;
  esac
}

# Parse "<sha> is the first bad commit" out of git bisect output. Not anchored
# to start-of-line: `bash -lc` sources the login profile, which can emit a
# terminal escape sequence (e.g. ]1337;SetColorScheme) with no trailing newline
# right before git's output, so the SHA is not always the first byte on its
# line. `-a` treats the stream as text in case a stray control byte appears.
parse_culprit() {
  grep -aoE '[0-9a-f]{7,40} is the first bad commit' | head -n1 | cut -d' ' -f1
}

# --------------------------------------------------------------------------
# Core bisect over an already-resolved (repo, bad, good, cmd).
# Emits result via the caller-provided `writeback` and `note` functions.
# Returns: 0 = culprit found, 1 = unreproducible/guard-failed, 2 = infra error.
# Sets globals: RESULT_STATE, RESULT_CULPRIT, RESULT_SUBJECT, RESULT_REASON, RESULT_LOG
# --------------------------------------------------------------------------
run_bisect() {
  local repo="$1" bad="$2" good="$3" cmd="$4" tag="$5"
  RESULT_STATE=""; RESULT_CULPRIT=""; RESULT_SUBJECT=""; RESULT_REASON=""; RESULT_LOG=""

  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { RESULT_STATE=failed; RESULT_REASON="not a git repo: $repo"; return 2; }

  # Both endpoints must be real commits, distinct, and good must be an ancestor
  # of bad. A non-ancestor good means we cannot bisect a linear range and must
  # not guess.
  git -C "$repo" cat-file -e "$bad^{commit}" 2>/dev/null \
    || { RESULT_STATE=unreproducible; RESULT_REASON="bad commit not present: $bad"; return 1; }
  git -C "$repo" cat-file -e "$good^{commit}" 2>/dev/null \
    || { RESULT_STATE=unreproducible; RESULT_REASON="good commit not present: $good"; return 1; }
  local bad_full good_full
  bad_full="$(git -C "$repo" rev-parse "$bad^{commit}")"
  good_full="$(git -C "$repo" rev-parse "$good^{commit}")"
  if [[ "$bad_full" == "$good_full" ]]; then
    RESULT_STATE=unreproducible; RESULT_REASON="good and bad are the same commit ($bad_full)"; return 1
  fi
  if ! git -C "$repo" merge-base --is-ancestor "$good_full" "$bad_full"; then
    RESULT_STATE=unreproducible
    RESULT_REASON="good ($good_full) is not an ancestor of bad ($bad_full); cannot bisect"
    return 1
  fi

  mkdir -p "$BISECT_WORKTREE_BASE" "$BISECT_LOG_DIR"
  local stamp short logf wt
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  short="${bad_full:0:12}"
  logf="$BISECT_LOG_DIR/$tag-$short-$stamp.log"
  wt="$BISECT_WORKTREE_BASE/bisect-$tag-$short-$stamp"
  RESULT_LOG="$logf"
  _bl() { printf '%s\n' "$@" >>"$logf"; }

  {
    echo "bisect job"
    echo "  tag:     $tag"
    echo "  repo:    $repo"
    echo "  bad:     $bad_full"
    echo "  good:    $good_full"
    echo "  command: $cmd"
    echo "  started: $(date -u +%FT%TZ)"
    echo "  worktree:$wt"
    echo
  } >"$logf"

  if ! git -C "$repo" worktree add --detach "$wt" "$bad_full" >>"$logf" 2>&1; then
    RESULT_STATE=failed; RESULT_REASON="worktree-add-failed (see $logf)"; return 2
  fi

  # Guaranteed cleanup of the bisect worktree.
  local keep_wt=0
  cleanup_wt() {
    git -C "$wt" bisect reset >>"$logf" 2>&1 || true
    if [[ "$keep_wt" == 1 && "$BISECT_KEEP_WORKTREE" != never ]]; then
      return 0
    fi
    if [[ "$BISECT_KEEP_WORKTREE" == always ]]; then return 0; fi
    git -C "$repo" worktree remove --force "$wt" >>"$logf" 2>&1 || true
  }

  # --- Oracle guards: the failure MUST reproduce locally before we trust a
  # bisect. CI-red is not proof that `cmd` fails here (different suite, flake,
  # infra). Confirm good PASSES and bad FAILS with this exact command. ---
  local rc_good rc_bad v_good v_bad
  _bl "== oracle guard: good ($good_full) must PASS =="
  git -C "$wt" checkout -q "$good_full" >>"$logf" 2>&1
  run_cmd "$wt" "$cmd" "$logf"; rc_good=$?
  v_good="$(classify_rc "$rc_good")"
  _bl "== good exit: $rc_good ($v_good) ==" ""

  _bl "== oracle guard: bad ($bad_full) must FAIL =="
  git -C "$wt" checkout -q "$bad_full" >>"$logf" 2>&1
  run_cmd "$wt" "$cmd" "$logf"; rc_bad=$?
  v_bad="$(classify_rc "$rc_bad")"
  _bl "== bad exit: $rc_bad ($v_bad) ==" ""

  if [[ "$v_good" != good ]]; then
    RESULT_STATE=unreproducible
    RESULT_REASON="oracle guard failed: good commit did not cleanly pass locally (exit $rc_good/$v_good); not bisecting on an unconfirmed range"
    keep_wt=1; cleanup_wt; return 1
  fi
  # A bad endpoint that times out / cannot build / is signalled is NOT a
  # reproduction: v_bad must be a genuine test failure, not skip.
  if [[ "$v_bad" != bad ]]; then
    RESULT_STATE=unreproducible
    RESULT_REASON="oracle guard failed: bad commit did not cleanly fail locally (exit $rc_bad/$v_bad); a timeout/unrunnable/flake, not a reproduction of the CI failure"
    keep_wt=1; cleanup_wt; return 1
  fi

  # --- Bisect via a step wrapper that (a) enforces the per-step timeout git
  # bisect would otherwise bypass, and (b) maps exit codes the same way the
  # guards do: 0=good, timeout/unrunnable/signal=125 (git "skip", so a
  # commit we cannot test is skipped, never blamed), any other nonzero=bad. ---
  _bl "== git bisect run (whole $BISECT_TIMEOUT, per-step $BISECT_STEP_TIMEOUT) =="
  local bisect_out rc_bisect wrapper to_pre=""
  command -v timeout >/dev/null 2>&1 && to_pre="timeout $BISECT_STEP_TIMEOUT"
  wrapper="$BISECT_WORKTREE_BASE/.bisect-step-$stamp.sh"
  {
    # Dynamic first lines (timeout prefix + the quoted command); $? stays
    # literal for the generated script via the single-quoted format string.
    printf '#!/usr/bin/env bash\nrc=0\n'
    printf '%s bash -lc %s || rc=$?\n' "$to_pre" "$(printf '%q' "$cmd")"
    # Static exit-code mapping, kept verbatim by the quoted heredoc.
    cat <<'STEP_EOF'
case $rc in
  0) exit 0 ;;
  124|125|126|127) exit 125 ;;
  *) if [ $rc -ge 128 ]; then exit 125; else exit 1; fi ;;
esac
STEP_EOF
  } >"$wrapper"
  chmod +x "$wrapper"

  git -C "$wt" bisect start "$bad_full" "$good_full" >>"$logf" 2>&1
  rc_bisect=0
  if command -v timeout >/dev/null 2>&1; then
    bisect_out="$(cd "$wt" && timeout "$BISECT_TIMEOUT" git bisect run "$wrapper" 2>&1)" || rc_bisect=$?
  else
    bisect_out="$(cd "$wt" && git bisect run "$wrapper" 2>&1)" || rc_bisect=$?
  fi
  rm -f "$wrapper"
  printf '%s\n' "$bisect_out" >>"$logf"
  _bl "== bisect run exit: $rc_bisect =="

  local culprit
  culprit="$(parse_culprit <<<"$bisect_out")"
  if [[ "$rc_bisect" -ne 0 && -z "$culprit" ]]; then
    RESULT_STATE=failed
    RESULT_REASON="git bisect run failed or timed out (exit $rc_bisect); see $logf"
    keep_wt=1; cleanup_wt; return 2
  fi
  if [[ -z "$culprit" ]]; then
    RESULT_STATE=failed
    RESULT_REASON="could not parse first-bad commit from bisect output; see $logf"
    keep_wt=1; cleanup_wt; return 2
  fi

  RESULT_CULPRIT="$(git -C "$wt" rev-parse "$culprit^{commit}")"
  RESULT_SUBJECT="$(git -C "$repo" show -s --format='%h %an: %s' "$RESULT_CULPRIT" 2>/dev/null || echo "$RESULT_CULPRIT")"
  RESULT_STATE="done"
  RESULT_REASON="first bad commit: $RESULT_SUBJECT"
  _bl "== culprit: $RESULT_CULPRIT ==" "$RESULT_SUBJECT"
  cleanup_wt
  return 0
}

# ==========================================================================
# Mode A: hermetic job-file (test only) — no bd, no gh, no network.
# ==========================================================================
if [[ -n "$JOB_FILE" ]]; then
  [[ -f "$JOB_FILE" ]] || tri_die "BISECT_JOB_FILE not found: $JOB_FILE"
  jf_repo=""; jf_bad=""; jf_good=""; jf_cmd=""
  while IFS='=' read -r k v; do
    case "$k" in
      repo) jf_repo="$v" ;;
      bad) jf_bad="$v" ;;
      good) jf_good="$v" ;;
      cmd) jf_cmd="$v" ;;
      *) : ;;
    esac
  done <"$JOB_FILE"
  jf_repo="${BISECT_REPO:-$jf_repo}"
  jf_cmd="${BISECT_CMD:-$jf_cmd}"
  [[ -n "$jf_repo" && -n "$jf_bad" && -n "$jf_good" && -n "$jf_cmd" ]] \
    || tri_die "job file must define repo, bad, good, cmd"

  run_bisect "$jf_repo" "$jf_bad" "$jf_good" "$jf_cmd" "test"
  rc=$?
  {
    echo "result_state=$RESULT_STATE"
    echo "result_culprit=$RESULT_CULPRIT"
    echo "result_subject=$RESULT_SUBJECT"
    echo "result_reason=$RESULT_REASON"
    echo "result_log=$RESULT_LOG"
  } >>"$JOB_FILE"
  echo "bisect ($JOB_FILE): state=$RESULT_STATE culprit=${RESULT_CULPRIT:-none}"
  exit "$rc"
fi

# ==========================================================================
# Mode B: production — bd is the queue, gh + bd-main provide the SHAs.
# ==========================================================================
tri_require bd git jq gh

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pr-babysit"
mkdir -p "$STATE_DIR"
# Serialize bisect runs against each other. Serialization against the verify
# queue is provided by sharing the verify-babysit oneshot (sequential
# ExecStart), not a shared lock; a manually-run verify-next during a timer-run
# bisect is the one uncovered race and is documented in scripts/README.md.
exec 9>"$STATE_DIR/bisect.lock"
flock -n 9 || { echo "another bisect-next holds the lock; exiting."; exit 0; }

log_warn() { echo "bisect-next: $*" >&2; }

# Write bisect_* metadata back to the bead. Only ever bisect_* keys + one note;
# never status/labels/claim/assignee.
finish_meta() {
  local id="$1" state="$2" reason="$3"
  local now; now="$(date -u +%FT%TZ)"
  local args=(update "$id"
    --set-metadata "bisect_state=$state"
    --set-metadata "bisect_result=$reason"
    --set-metadata "bisect_finished_at=$now")
  [[ -n "${RESULT_BAD:-}" ]] && args+=(--set-metadata "bisect_bad=$RESULT_BAD")
  [[ -n "${RESULT_GOOD:-}" ]] && args+=(--set-metadata "bisect_good=$RESULT_GOOD")
  [[ -n "${RESULT_CULPRIT:-}" ]] && args+=(--set-metadata "bisect_culprit=$RESULT_CULPRIT")
  [[ -n "${RESULT_SUBJECT:-}" ]] && args+=(--set-metadata "bisect_culprit_subject=$RESULT_SUBJECT")
  [[ -n "${RESULT_LOG:-}" ]] && args+=(--set-metadata "bisect_log=$RESULT_LOG")
  # Retry a few times: a transient Dolt lock must not leave the bead stuck at
  # 'running' with a successful bisect silently discarded. If it still fails,
  # the bead stays 'running' and select_job re-picks it next pass (safe: the
  # flock guarantees no other bisect is mid-run), so the diagnosis is redone
  # rather than lost.
  local i wrote=0
  for i in 1 2 3; do
    if bd "${args[@]}" >/dev/null 2>&1; then wrote=1; break; fi
    [[ "$i" -lt 3 ]] && sleep 2
  done
  if [[ "$wrote" == 0 ]]; then
    log_warn "$id: bisect_state=$state writeback failed after retries; bead left for re-pick"
    return 1
  fi
  case "$state" in
    done) tri_log_note "$id" "bisect done: culprit ${RESULT_CULPRIT:0:12} — ${RESULT_SUBJECT:-}. Log: ${RESULT_LOG:-}" ;;
    *) tri_log_note "$id" "bisect $state: $reason" ;;
  esac
}

# Select a base-red bead needing a bisect: explicit id, else FIFO by
# priority/age. 'running' is selectable too, not just 'queued': the flock above
# guarantees no other bisect is mid-run, so any bead still marked 'running' is a
# stranded prior run (crash, or a terminal writeback that lost a Dolt-lock race)
# and is safe to redo.
select_job() {
  if [[ $# -eq 1 ]]; then
    tri_resolve_bd_id "$1"; return
  fi
  bd list --label base-red --limit 0 --json 2>/dev/null \
    | jq -r '[.[] | select(.status == "open"
               and ((.metadata.bisect_state // "") | . == "queued" or . == "running"))]
             | sort_by((.priority // 99), (.updated_at // "")) | (.[0].id // empty)'
}

BD_ID="$(select_job "$@")"
if [[ -z "$BD_ID" ]]; then
  echo "No queued base-red bisect jobs."
  exit 0
fi

issue_json="$(bd show "$BD_ID" --json)" || tri_die "cannot read $BD_ID"
status="$(jq -r '.[0].status // empty' <<<"$issue_json")"
bstate="$(jq -r '.[0].metadata.bisect_state // empty' <<<"$issue_json")"
key="$(jq -r '.[0].metadata.pr_babysit_red_base // empty' <<<"$issue_json")"
cmd="$(jq -r '.[0].metadata.bisect_cmd | if . == null or . == "" then "" else tostring end' <<<"$issue_json")"
cmd="${BISECT_CMD:-${cmd:-make test}}"

# Fail closed on anything unexpected rather than bisecting the wrong thing.
[[ "$status" == "open" ]] || { echo "$BD_ID is $status, not open; skipping."; exit 0; }
[[ "$bstate" == "queued" || "$bstate" == "running" ]] || { echo "$BD_ID bisect_state is '$bstate', not queued/running; skipping."; exit 0; }
[[ -n "$key" ]] || { finish_meta "$BD_ID" skipped "no pr_babysit_red_base key on bead"; exit 0; }

repo="${key%@*}"; branch="${key#*@}"
if [[ -z "$repo" || -z "$branch" || "$repo" == "$key" ]]; then
  finish_meta "$BD_ID" skipped "malformed base key: $key"
  exit 0
fi

# Only the upstream we actually clone can be bisected locally.
if [[ "$repo" != "$TRI_UPSTREAM" ]]; then
  finish_meta "$BD_ID" skipped "base repo $repo is not the local upstream ($TRI_UPSTREAM); no clone to bisect"
  echo "Skipped $BD_ID: $repo != $TRI_UPSTREAM."
  exit 0
fi
[[ -d "$TRI_BD_MAIN/.git" || -f "$TRI_BD_MAIN/.git" ]] \
  || { finish_meta "$BD_ID" skipped "no beads clone at $TRI_BD_MAIN"; exit 0; }

# Mark running before the expensive part so a crash is visible as 'running'
# rather than silently stuck at 'queued'.
bd update "$BD_ID" \
  --set-metadata bisect_state=running \
  --set-metadata "bisect_started_at=$(date -u +%FT%TZ)" \
  --set-metadata "bisect_cmd=$cmd" \
  --set-metadata "bisect_runner=$(hostname -s 2>/dev/null || echo unknown):$$" \
  >/dev/null 2>&1 || log_warn "$BD_ID: could not mark running"

# Fetch the upstream branch, then resolve endpoints.
if ! git -C "$TRI_BD_MAIN" fetch --quiet upstream "$branch" 2>/dev/null; then
  finish_meta "$BD_ID" failed "git fetch upstream $branch failed"
  echo "Bisect failed for $BD_ID: fetch." >&2
  exit 1
fi

RESULT_BAD="$(git -C "$TRI_BD_MAIN" rev-parse "upstream/$branch^{commit}" 2>/dev/null || true)"
[[ -n "$RESULT_BAD" ]] || { finish_meta "$BD_ID" failed "cannot resolve upstream/$branch"; exit 1; }

# Last-green: the most recent successful CI run on this branch whose head is an
# ancestor of the red tip. gh may list runs from several workflows; the oracle
# guard (good must actually PASS the command locally) is what protects us from
# a green run that does not correspond to a passing build of `cmd`.
#
# Capture gh's exit status explicitly: a failed query (auth, rate limit,
# network) must NOT be mistaken for "genuinely no successful runs", which would
# terminalize the job as no-good-sha and never retry. On query failure, leave
# the bead 'running' (select_job re-picks it next pass) and exit cleanly.
gh_out="$(gh run list --repo "$repo" --branch "$branch" --status success \
  --limit "$BISECT_MAX_GOOD_SCAN" --json headSha,createdAt 2>/dev/null)"
gh_rc=$?
if [[ "$gh_rc" -ne 0 ]] || ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$gh_out"; then
  log_warn "$BD_ID: 'gh run list' failed (exit $gh_rc); leaving 'running' to retry next pass"
  echo "Bisect deferred for $BD_ID: gh query failed; will retry."
  exit 0
fi
RESULT_GOOD=""
mapfile -t good_candidates < <(
  jq -r 'sort_by(.createdAt) | reverse | .[].headSha' <<<"$gh_out" | tr -d '\r'
)
for sha in "${good_candidates[@]}"; do
  [[ -n "$sha" ]] || continue
  git -C "$TRI_BD_MAIN" cat-file -e "$sha^{commit}" 2>/dev/null || continue
  [[ "$(git -C "$TRI_BD_MAIN" rev-parse "$sha^{commit}")" != "$RESULT_BAD" ]] || continue
  if git -C "$TRI_BD_MAIN" merge-base --is-ancestor "$sha" "$RESULT_BAD" 2>/dev/null; then
    RESULT_GOOD="$(git -C "$TRI_BD_MAIN" rev-parse "$sha^{commit}")"
    break
  fi
done
if [[ -z "$RESULT_GOOD" ]]; then
  finish_meta "$BD_ID" no-good-sha "no recent successful CI run on $branch resolves to an ancestor of $RESULT_BAD (scanned $BISECT_MAX_GOOD_SCAN); cannot bound the bisect"
  echo "Bisect for $BD_ID: no good SHA found."
  exit 0
fi

run_bisect "$TRI_BD_MAIN" "$RESULT_BAD" "$RESULT_GOOD" "$cmd" "$BD_ID"
rc=$?
finish_meta "$BD_ID" "$RESULT_STATE" "$RESULT_REASON"

case "$RESULT_STATE" in
  done) echo "Bisect done for $BD_ID: culprit $RESULT_CULPRIT ($RESULT_SUBJECT). Log: $RESULT_LOG" ;;
  *) echo "Bisect $RESULT_STATE for $BD_ID: $RESULT_REASON" >&2 ;;
esac
exit "$rc"
