#!/usr/bin/env bash
# tri-drift — flag already-triaged stubs whose upstream item moved since triage.
#
# tri-sync only notices TERMINAL upstream states (merged/closed). This script
# notices ACTIVITY: a new comment, label, or edit on an upstream issue/PR that
# we already classified. A tri:defer or tri:needs-info stub can silently become
# urgent; this is the zero-token detector for that.
#
# Walks open bd stubs with gh-(pr|iss)-NNNN refs that carry a tri:* label,
# compares upstream updatedAt against a machine-local baseline, and on movement
# applies the tri:stale label plus an audit note. Baselines live in
# ${XDG_STATE_HOME:-~/.local/state}/mybd/tri-drift.state (one "ref updatedAt"
# per line). First sighting of a ref seeds the baseline silently.
#
# Claimed (in_progress) stubs are excluded by construction: activity on work
# in flight is expected, and bd list --status=open does not return them.
# Stubs already labeled tri:stale get their baseline refreshed without a new
# note — the flag is already up; re-triage removes it.
#
# Usage:
#   tri-drift                  # full pass: issues + PRs
#   tri-drift --issues-only
#   tri-drift --prs-only
#   tri-drift --dry-run        # preview, no bd writes, no baseline updates
#   tri-drift --limit N        # cap items processed
#
# Idempotent: flagging advances the baseline, so one upstream event produces
# one flag, not one per run.

set -euo pipefail

. "$(dirname "$0")/_tri-lib.sh"

UPSTREAM="$TRI_UPSTREAM"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="${TRI_DRIFT_STATE:-$STATE_HOME/mybd/tri-drift.state}"
DRY_RUN=0
LIMIT=0
DO_PRS=1
DO_ISSUES=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift;;
    --prs-only) DO_ISSUES=0; shift;;
    --issues-only) DO_PRS=0; shift;;
    --limit) LIMIT="$2"; shift 2;;
    --limit=*) LIMIT="${1#--limit=}"; shift;;
    -h|--help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) tri_die "unknown arg: $1";;
  esac
done

tri_require bd gh jq

mkdir -p "$(dirname "$STATE_FILE")"
touch "$STATE_FILE"

# Baselines: ref -> last-seen upstream updatedAt (ISO8601 UTC; lexicographic
# comparison is chronological for this format).
declare -A baseline
while read -r ref ts; do
  [[ -n "$ref" && -n "$ts" ]] && baseline["$ref"]="$ts"
done <"$STATE_FILE"

# Emit "<bd-id> <ref> <stale:0|1>" per open, triaged (tri:*-labeled) stub.
list_triaged_open() {
  bd list --status=open --limit 0 --json 2>/dev/null \
    | jq -r '.[]
        | select(.external_ref != null and (.external_ref | test("^gh-(pr|iss)-[0-9]+$")))
        | select((.labels // []) | map(startswith("tri:")) | any)
        | "\(.id) \(.external_ref) \(if ((.labels // []) | index("tri:stale")) then 1 else 0 end)"'
}

flagged=0
seeded=0
refreshed=0
skipped=0
processed=0
state_dirty=0

while read -r bd_id ref already_stale; do
  [[ -z "$bd_id" ]] && continue
  if [[ "$LIMIT" -gt 0 && "$processed" -ge "$LIMIT" ]]; then
    break
  fi

  parsed="$(tri_parse_ref "$ref")" || { skipped=$((skipped + 1)); continue; }
  read -r kind num <<<"$parsed"

  if [[ "$kind" == "pr" && "$DO_PRS" == 0 ]]; then continue; fi
  if [[ "$kind" == "iss" && "$DO_ISSUES" == 0 ]]; then continue; fi
  processed=$((processed + 1))

  if [[ "$kind" == "pr" ]]; then
    json="$(gh pr view "$num" --repo "$UPSTREAM" --json updatedAt 2>/dev/null || true)"
  else
    json="$(gh issue view "$num" --repo "$UPSTREAM" --json updatedAt 2>/dev/null || true)"
  fi
  updated="$(jq -r '.updatedAt // empty' <<<"${json:-null}" 2>/dev/null || true)"
  if [[ ! "$updated" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]]; then
    echo "  ? $bd_id ($ref): could not read upstream updatedAt, skipping" >&2
    skipped=$((skipped + 1))
    continue
  fi

  prev="${baseline[$ref]:-}"
  if [[ -z "$prev" ]]; then
    baseline["$ref"]="$updated"
    state_dirty=1
    seeded=$((seeded + 1))
    continue
  fi

  if [[ "$updated" > "$prev" ]]; then
    if [[ "$already_stale" == 1 ]]; then
      # Flag is already up; just move the baseline forward.
      refreshed=$((refreshed + 1))
    elif [[ "$DRY_RUN" == 1 ]]; then
      echo "  ✓ $bd_id ($ref): would flag tri:stale — upstream moved $prev -> $updated"
      flagged=$((flagged + 1))
      continue  # keep baseline so a real run still flags it
    else
      bd update "$bd_id" --add-label tri:stale >/dev/null
      tri_log_note "$bd_id" "tri-drift: upstream activity after triage ($prev -> $updated); re-triage and remove tri:stale"
      echo "  ✓ $bd_id ($ref): flagged tri:stale — upstream moved $prev -> $updated"
      flagged=$((flagged + 1))
    fi
    baseline["$ref"]="$updated"
    state_dirty=1
  fi
done < <(list_triaged_open)

if [[ "$DRY_RUN" == 0 && "$state_dirty" == 1 ]]; then
  tmp="$(mktemp "${STATE_FILE}.XXXXXX")"
  for ref in "${!baseline[@]}"; do
    printf '%s %s\n' "$ref" "${baseline[$ref]}"
  done | sort >"$tmp"
  mv -f "$tmp" "$STATE_FILE"
fi

if [[ "$DRY_RUN" == 1 ]]; then
  echo "DRY-RUN: would flag $flagged stale; seeded $seeded; refreshed $refreshed; skipped $skipped; checked $processed"
else
  echo "Flagged $flagged stale; seeded $seeded; refreshed $refreshed; skipped $skipped; checked $processed"
fi
