#!/usr/bin/env bash
# test-agent-hooks - verify the canonical, cross-platform agent hook configs.
#
# Usage: scripts/test-agent-hooks
#
# Exits non-zero if any check fails (unlike the warn-only session-close-check
# style this borrows structure from). Three groups:
#   1. Config schema - .codex/hooks.json and .claude/settings.json parse as
#      JSON; .codex/hooks.json carries all four bd codex-hook lifecycle
#      events, and SessionStart also fires the session-start-stamp hook.
#   2. Cross-platform command resolution - no Windows-only paths/binaries in
#      either hooks config, and every command referencing a repo script uses
#      an explicit shell compatible with that script.
#   3. session-start-stamp TTL behavior, exercised in a throwaway temp repo.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

CODEX_HOOKS="$root/.codex/hooks.json"
CLAUDE_SETTINGS="$root/.claude/settings.json"
STAMP_SCRIPT="$root/scripts/session-start-stamp"
CLAUDE_FIXTURE="$root/scripts/fixtures/claude-pretooluse-bash.json"
CODEX_FIXTURE="$root/scripts/fixtures/codex-pretooluse-shell.json"

fails=0
pass() { printf 'PASS: %s\n' "$*"; }
fail() { printf 'FAIL: %s\n' "$*" >&2; fails=$((fails + 1)); }

command -v jq >/dev/null 2>&1 || { echo "test-agent-hooks: jq is required" >&2; exit 2; }

# --- Group 1: config schema -------------------------------------------------

if jq empty "$CODEX_HOOKS" >/dev/null 2>&1; then
  pass "$CODEX_HOOKS parses as JSON"
else
  fail "$CODEX_HOOKS does not parse as JSON"
fi

if jq empty "$CLAUDE_SETTINGS" >/dev/null 2>&1; then
  pass "$CLAUDE_SETTINGS parses as JSON"
else
  fail "$CLAUDE_SETTINGS does not parse as JSON"
fi

# event_has_command <event> <regex> - true if any hook command under
# .hooks[event][].hooks[] matches regex.
event_has_command() {
  local event="$1" pattern="$2"
  jq -e --arg event "$event" --arg pattern "$pattern" '
    (.hooks[$event] // []) as $entries
    | any($entries[]; (.hooks // [])[]? | (.command // "") | test($pattern))
  ' "$CODEX_HOOKS" >/dev/null 2>&1
}

for event in SessionStart PreCompact PostCompact UserPromptSubmit; do
  if event_has_command "$event" "^bd codex-hook ${event}\$"; then
    pass "$CODEX_HOOKS: $event fires bd codex-hook $event"
  else
    fail "$CODEX_HOOKS: $event is missing a 'bd codex-hook $event' command"
  fi
done

if event_has_command "SessionStart" "session-start-stamp"; then
  pass "$CODEX_HOOKS: SessionStart also fires the session-start-stamp hook"
else
  fail "$CODEX_HOOKS: SessionStart is missing the session-start-stamp hook"
fi

if jq -e '.hooks.PreToolUse | length == 1
          and .[0].matcher == ".*"
          and ([.[0].hooks[].command | test("pr-review-gate|destructive-guard")] | length == 2 and all)
          and (.[] | .hooks | map(.command) | .[0] | test("pr-review-gate"))' \
     "$CODEX_HOOKS" >/dev/null 2>&1; then
  pass "$CODEX_HOOKS: PreToolUse covers all tools and orders both guards correctly"
else
  fail "$CODEX_HOOKS: PreToolUse is missing, mismatched, or orders its guards incorrectly"
fi

# --- Group 2: cross-platform command resolution -----------------------------

for file in "$CODEX_HOOKS" "$CLAUDE_SETTINGS"; do
  if grep -qE '[A-Z]:\\' "$file"; then
    fail "$file: contains a drive-letter path (e.g. C:\\...)"
  else
    pass "$file: no drive-letter paths"
  fi

  if grep -qi 'bash\.exe' "$file"; then
    fail "$file: contains a bash.exe reference"
  else
    pass "$file: no bash.exe reference"
  fi

  if grep -qi 'PROGRA~1' "$file"; then
    fail "$file: contains a PROGRA~1 short-path reference"
  else
    pass "$file: no PROGRA~1 short-path reference"
  fi

  # Every command that references a repo script (session-start-stamp is the
  # only one currently invoked from these configs) must use `bash <script>` or
  # `bash -c ...`: session-start-stamp uses Bash syntax and cannot run under
  # POSIX sh on Linux.
  bad_commands="$(
    jq -r '
      [.. | objects | .command? // empty]
      | .[]
      | select(test("scripts/") or test("session-start-stamp"))
      | select((startswith("bash ") or startswith("bash -c")) | not)
    ' "$file" 2>/dev/null
  )"
  if [[ -z "$bad_commands" ]]; then
    pass "$file: every repo-script command uses bash <script> or bash -c form"
  else
    while IFS= read -r cmd; do
      [[ -n "$cmd" ]] && fail "$file: repo-script command not in 'bash' form: $cmd"
    done <<<"$bad_commands"
  fi
done

# Codex does not provide a project-root environment variable to hooks. Its
# commands must locate scripts from PWD so nested worktree directories work.
if jq -e '[.hooks.PreToolUse[].hooks[].command, .hooks.SessionStart[].hooks[].command]
          | map(select(test("scripts/(session-start-stamp|pr-review-gate|destructive-guard)")))
          | length >= 3 and all(test("d=\\$PWD") and test("dirname"))' "$CODEX_HOOKS" >/dev/null 2>&1; then
  pass "$CODEX_HOOKS: repo scripts self-resolve upward from PWD"
else
  fail "$CODEX_HOOKS: a repo script hook is cwd-relative or lacks PWD resolution"
fi

nested="$root/scripts/fixtures"
run_codex_hook() { # command fixture [cwd] [PATH] -> CODEX_HOOK_RC/OUT
  local command="$1" fixture="$2" hook_cwd="${3:-$nested}" hook_path="${4:-$PATH}" hook
  CODEX_HOOK_RC=0
  CODEX_HOOK_OUT=""
  while IFS= read -r hook; do
    CODEX_HOOK_OUT="$(cd "$hook_cwd" && jq --arg c "$command" --arg d "$hook_cwd" '.tool_input.command=$c | .cwd=$d' "$fixture" | PATH="$hook_path" bash -c "$hook" 2>&1)"
    CODEX_HOOK_RC=$?
    [[ $CODEX_HOOK_RC -eq 0 ]] || break
  done < <(jq -r '.hooks.PreToolUse[0].hooks[].command' "$CODEX_HOOKS")
}
for fixture in "$CLAUDE_FIXTURE" "$CODEX_FIXTURE"; do
  fixture_name="${fixture##*/}"
  run_codex_hook 'echo nested-hook-ok' "$fixture"; rc=$CODEX_HOOK_RC
  [[ $rc -eq 0 ]] && pass "Codex registered guards allow benign $fixture_name from nested cwd" \
    || fail "Codex registered guards failed benign $fixture_name from nested cwd (rc=$rc)"
  run_codex_hook 'rm -rf .bare' "$fixture"; rc=$CODEX_HOOK_RC
  [[ $rc -eq 2 && "${CODEX_HOOK_OUT,,}" == *"block"* ]] \
    && pass "Codex registered guards block .bare with a reason through $fixture_name from nested cwd" \
    || fail "Codex registered guards missed .bare or its blocking reason through $fixture_name from nested cwd (rc=$rc out=$CODEX_HOOK_OUT)"
done

# Isolate this check from the live worktree's HEAD and review-log state. A
# unique throwaway commit can never inherit a prior review verdict. Supplying
# a stub codex binary also tests the gate's active branch on hosts where the
# real CLI is not installed.
pr_hook_repo="$(mktemp -d "$root/.test-pr-hook.XXXXXX")"
pr_hook_bin="$(mktemp -d)"
cleanup_pr_hook() { rm -rf "$pr_hook_repo" "$pr_hook_bin"; }
trap cleanup_pr_hook EXIT
git init -q -b main "$pr_hook_repo"
git -C "$pr_hook_repo" config user.name test-agent-hooks
git -C "$pr_hook_repo" config user.email test-agent-hooks@example.invalid
git -C "$pr_hook_repo" config commit.gpgsign false
printf '%s\n' "unique gate fixture $$ $RANDOM" >"$pr_hook_repo/fixture"
git -C "$pr_hook_repo" add fixture
git -C "$pr_hook_repo" commit -q -m fixture
printf '%s\n' '#!/bin/sh' 'exit 0' >"$pr_hook_bin/codex"
chmod +x "$pr_hook_bin/codex"
run_codex_hook 'gh pr create --repo gastownhall/beads --title x' "$CODEX_FIXTURE" "$pr_hook_repo" "$pr_hook_bin:$PATH"; rc=$CODEX_HOOK_RC
[[ $rc -eq 2 && "${CODEX_HOOK_OUT,,}" == *"block"* ]] \
  && pass "Codex registered pr-review-gate blocks an unreviewed upstream PR with a reason" \
  || fail "Codex registered pr-review-gate missed an unreviewed upstream PR or its blocking reason (rc=$rc out=$CODEX_HOOK_OUT)"
cleanup_pr_hook
trap - EXIT

# A session outside the project tree must warn and return instead of looping
# forever while trying to walk above a path like /tmp.
if command -v timeout >/dev/null 2>&1; then
  no_match_runner=(timeout 3s)
elif command -v gtimeout >/dev/null 2>&1; then
  no_match_runner=(gtimeout 3s)
else
  no_match_runner=(perl -e 'alarm shift; exec @ARGV' 3)
fi
for hook in $(jq -r '.hooks.PreToolUse[0].hooks[].command | @base64' "$CODEX_HOOKS"); do
  hook="$(printf '%s' "$hook" | base64 -d)"
  no_match_out="$(cd /tmp && "${no_match_runner[@]}" bash -c "$hook" </dev/null 2>&1)"; no_match_rc=$?
  if [[ $no_match_rc -eq 0 && "$no_match_out" == *"could not resolve"* ]]; then
    pass "Codex registered guard terminates loudly when no project script is discoverable"
  else
    fail "Codex registered guard no-match resolution failed (rc=$no_match_rc out=$no_match_out)"
  fi
done

# This scripted app-server response proves the manual diagnostic reports the
# important state without requiring an untrusted hook to run first.
fakebin="$(mktemp -d)"
cat >"$fakebin/codex" <<'EOF'
#!/usr/bin/env bash
while IFS= read -r line; do
  id="$(jq -r '.id // empty' <<<"$line")"
  case "$id" in
    1) echo '{"id":1,"result":{}}' ;;
    2) case "${FAKE_CODEX_MODE:-good}" in
         good|disabled|wrong) source="$PWD/.codex/hooks.json"; enabled=true; first='bash scripts/pr-review-gate'; second='bash scripts/destructive-guard'
           [[ "$FAKE_CODEX_MODE" == disabled ]] && enabled=false
           [[ "$FAKE_CODEX_MODE" == wrong ]] && first=true
           jq -cn --arg source "$source" --arg first "$first" --arg second "$second" --argjson enabled "$enabled" \
             '{id:2,result:{data:[{hooks:[
               {eventName:"preToolUse",command:$first,trustStatus:"untrusted",enabled:$enabled,sourcePath:$source},
               {eventName:"preToolUse",command:$second,trustStatus:"untrusted",enabled:true,sourcePath:$source}
             ]}]}}' ;;
         error) echo '{"id":2,"error":{"code":-32603,"message":"probe failure"}}' ;;
         stall) : ;;
         notify) while :; do echo '{"method":"probe/notification","params":{}}'; sleep 0.05; done ;;
         stubborn) trap '' TERM; while :; do sleep 1; done ;;
       esac ;;
  esac
done
EOF
chmod +x "$fakebin/codex"
trust_out="$(PATH="$fakebin:$PATH" "$root/scripts/check-codex-hook-trust" 2>&1)"; trust_rc=$?
if [[ $trust_rc -eq 1 && "$trust_out" == *"untrusted: bash scripts/pr-review-gate"* ]]; then
  pass "check-codex-hook-trust reports registered-but-untrusted PreToolUse commands"
else
  fail "check-codex-hook-trust did not expose untrusted state (rc=$trust_rc out=$trust_out)"
fi
for fake_mode in disabled wrong; do
  trust_out="$(FAKE_CODEX_MODE="$fake_mode" PATH="$fakebin:$PATH" "$root/scripts/check-codex-hook-trust" 2>&1)"; trust_rc=$?
  if [[ $trust_rc -eq 1 ]]; then
    pass "check-codex-hook-trust rejects $fake_mode guard registration"
  else
    fail "check-codex-hook-trust accepted $fake_mode guard registration (rc=$trust_rc out=$trust_out)"
  fi
done
trust_out="$(FAKE_CODEX_MODE=error MYBD_CODEX_HOOK_CHECK_TIMEOUT=1 PATH="$fakebin:$PATH" "$root/scripts/check-codex-hook-trust" 2>&1)"; trust_rc=$?
if [[ $trust_rc -eq 2 && "$trust_out" == *"hooks/list failed"* ]]; then
  pass "check-codex-hook-trust rejects app-server JSON-RPC errors"
else
  fail "check-codex-hook-trust mishandled app-server error (rc=$trust_rc out=$trust_out)"
fi
trust_out="$(FAKE_CODEX_MODE=stall MYBD_CODEX_HOOK_CHECK_TIMEOUT=1 PATH="$fakebin:$PATH" "$root/scripts/check-codex-hook-trust" 2>&1)"; trust_rc=$?
if [[ $trust_rc -eq 2 && "$trust_out" == *"hooks/list failed"* ]]; then
  pass "check-codex-hook-trust times out when app-server stalls"
else
  fail "check-codex-hook-trust stall handling failed (rc=$trust_rc out=$trust_out)"
fi
for fake_mode in notify stubborn; do
  trust_out="$("${no_match_runner[@]}" env FAKE_CODEX_MODE="$fake_mode" MYBD_CODEX_HOOK_CHECK_TIMEOUT=1 PATH="$fakebin:$PATH" "$root/scripts/check-codex-hook-trust" 2>&1)"; trust_rc=$?
  if [[ $trust_rc -eq 2 && "$trust_out" == *"hooks/list failed"* ]]; then
    pass "check-codex-hook-trust bounds $fake_mode app-server behavior"
  else
    fail "check-codex-hook-trust $fake_mode handling failed (rc=$trust_rc out=$trust_out)"
  fi
done
rm -rf "$fakebin"

# --- Group 3: Beads hook wrapper portability -------------------------------

for hook in "$root/.githooks/pre-commit" "$root/.githooks/pre-push" "$root/.githooks/prepare-commit-msg"; do
  hook_name="${hook##*/}"
  for required in 'command -v timeout' 'command -v gtimeout' "perl -e 'alarm shift; exec @ARGV'" '_bd_used_perl=1' 'running without timeout' '[ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]'; do
    if grep -Fq "$required" "$hook"; then
      pass "$hook_name: preserves Beads portable timeout fallback: $required"
    else
      fail "$hook_name: missing Beads portable timeout fallback: $required"
    fi
  done
done

# --- Group 4: session-start-stamp TTL behavior ------------------------------

if [[ ! -x "$STAMP_SCRIPT" && ! -r "$STAMP_SCRIPT" ]]; then
  fail "session-start-stamp not found at $STAMP_SCRIPT"
else
  tmpdir="$(mktemp -d)"
  cleanup_tmpdir() { rm -rf "$tmpdir"; }
  trap cleanup_tmpdir EXIT

  (
    cd "$tmpdir" || exit 1
    git init -q .
    mkdir -p .beads
  )
  stamp="$tmpdir/.beads/.session-start"

  # a) no stamp -> running the script creates one.
  if [[ -f "$stamp" ]]; then
    fail "stamp TTL setup: unexpected pre-existing stamp"
  else
    (cd "$tmpdir" && bash "$STAMP_SCRIPT") >/dev/null 2>&1
    if [[ -f "$stamp" ]]; then
      pass "stamp TTL: no stamp -> script creates one"
    else
      fail "stamp TTL: no stamp -> script did not create one"
    fi
  fi

  # b) fresh stamp (now) -> running again does NOT overwrite.
  now_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s\tfakesha-fresh\n' "$now_iso" >"$stamp"
  before="$(cat "$stamp")"
  (cd "$tmpdir" && bash "$STAMP_SCRIPT") >/dev/null 2>&1
  after="$(cat "$stamp")"
  if [[ "$before" == "$after" ]]; then
    pass "stamp TTL: fresh stamp is not overwritten"
  else
    fail "stamp TTL: fresh stamp was overwritten (before=[$before] after=[$after])"
  fi

  # c) stale stamp (older than default TTL, 5h back) -> overwritten.
  stale_epoch=$(( $(date -u +%s) - 5 * 3600 ))
  stale_iso="$(date -u -d "@${stale_epoch}" +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s\tfakesha-stale\n' "$stale_iso" >"$stamp"
  before="$(cat "$stamp")"
  (cd "$tmpdir" && bash "$STAMP_SCRIPT") >/dev/null 2>&1
  after="$(cat "$stamp")"
  if [[ "$before" != "$after" ]]; then
    pass "stamp TTL: stale stamp (5h, default TTL) is overwritten"
  else
    fail "stamp TTL: stale stamp (5h, default TTL) was NOT overwritten (still [$after])"
  fi

  # d) MYBD_SESSION_STAMP_TTL=1 with a 2-second-old stamp -> overwritten.
  recent_epoch=$(( $(date -u +%s) - 2 ))
  recent_iso="$(date -u -d "@${recent_epoch}" +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s\tfakesha-recent\n' "$recent_iso" >"$stamp"
  before="$(cat "$stamp")"
  (cd "$tmpdir" && MYBD_SESSION_STAMP_TTL=1 bash "$STAMP_SCRIPT") >/dev/null 2>&1
  after="$(cat "$stamp")"
  if [[ "$before" != "$after" ]]; then
    pass "stamp TTL: MYBD_SESSION_STAMP_TTL=1 overwrites a 2s-old stamp"
  else
    fail "stamp TTL: MYBD_SESSION_STAMP_TTL=1 did NOT overwrite a 2s-old stamp (still [$after])"
  fi

  trap - EXIT
  cleanup_tmpdir
fi

# --- Summary -----------------------------------------------------------------

if [[ "$fails" -eq 0 ]]; then
  echo "test-agent-hooks: all checks passed"
  exit 0
else
  echo "test-agent-hooks: $fails check(s) failed"
  exit 1
fi
