[Unit]
Description=Handoff-index patrol (zero-token babysitter for gastownhall/beads#5711 checkboxes, the jart4 gate, and fleet-regression flags)

[Service]
Type=oneshot
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_ASKPASS=/bin/true
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart="@ROOT@/scripts/index-babysit"
TimeoutStartSec=10min
