[Unit]
Description=PR merge-tail patrol (zero-token babysitter for merge-when-green and close-when-quiet beads)

[Service]
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_ASKPASS=/bin/true
Type=oneshot
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart="@ROOT@/scripts/pr-babysit"
TimeoutStartSec=10min
