[Unit]
Description=Unattended tri:claim issue-sweep lane (model-driven; proposes dispositions, publishes nothing)

[Service]
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_ASKPASS=/bin/true
Type=oneshot
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=@ROOT@
ExecStart="@ROOT@/scripts/solo-sweep"
# Must exceed SOLO_SWEEP_TIMEOUT (45m) plus the commit/hook/push tail, or a
# SIGTERM can land mid-commit and leave the checkout in a state the next run
# refuses to touch.
TimeoutStartSec=90min
