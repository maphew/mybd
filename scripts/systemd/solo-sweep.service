[Unit]
Description=Unattended tri:claim issue-sweep lane (model-driven; proposes dispositions, publishes nothing)

[Service]
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_ASKPASS=/bin/true
Type=oneshot
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=@ROOT@
ExecStart="@ROOT@/scripts/solo-sweep"
# Must exceed SOLO_SWEEP_TIMEOUT (45m) plus the commit/hook/push tail, or a
# SIGTERM can land mid-commit and leave the checkout in a state the next run
# refuses to touch.
TimeoutStartSec=90min

# --- sandbox -----------------------------------------------------------------
# The permission allowlist is enforced by Claude Code; these are enforced by the
# kernel. That distinction is the point: allowlist semantics can change under us
# in a harness upgrade, and this lane runs unsupervised for a week.
#
# Verified by probe 2026-07-29: gh auth, bd, and claude all work under these
# settings, and reads of ~/.ssh fail with EACCES.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Everything outside these is read-only. bd's embedded Dolt DB lives under the
# repo; Claude Code needs its own state and cache.
ReadWritePaths=@ROOT@ %h/.claude %h/.cache %h/.config %h/.local/state %h/.local/share
# NOTE: credentials are deliberately NOT hidden at the unit level.
#
# origin resolves to git@github.com via an insteadOf rewrite and the bd Dolt
# remote is git+ssh, so the WRAPPER needs ~/.ssh to publish anything at all.
# Hiding it here broke publishing outright (observed 2026-07-30). The model is
# the untrusted half, not the wrapper, so scripts/solo-sweep runs just the
# `claude` invocation under bwrap with ~/.ssh, ~/.gnupg, ~/.codex, ~/.aws,
# ~/.docker and ~/.kube masked by tmpfs. Keep that split: re-adding
# InaccessiblePaths for those directories here will silently stop the lane
# pushing its own work.
