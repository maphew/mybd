[Unit]
Description=Unattended tri:claim issue-sweep lane (model-driven; proposes dispositions, publishes nothing)

[Service]
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_ASKPASS=/bin/true
Type=oneshot
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=@ROOT@
ExecStart="@ROOT@/scripts/solo-sweep"
# Must exceed SOLO_SWEEP_TIMEOUT (45m) plus the commit/hook/push tail, or a
# SIGTERM can land mid-commit and leave the checkout in a state the next run
# refuses to touch.
TimeoutStartSec=90min

# --- sandbox -----------------------------------------------------------------
# Only NAMESPACE-FREE hardening lives here. Anything that makes systemd build a
# mount namespace — PrivateTmp, ProtectSystem, ProtectClock, ProtectHostname,
# ProtectKernel*, ProtectControlGroups — makes OpenSSH reject
# /etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf ("Bad owner or permissions";
# it is a symlink into /usr/lib/systemd). origin resolves to git@github.com via
# an insteadOf rewrite and the bd Dolt remote is git+ssh, so that error stops
# the lane publishing anything at all — bisected 2026-07-30, every one of those
# directives reproduces it, and `bare` does not.
#
# The filesystem sandbox therefore lives where the untrusted code actually runs:
# scripts/solo-sweep executes the `claude` invocation under bwrap, with the repo
# read-only except reports/ and .beads/, and ~/.ssh, ~/.gnupg, ~/.codex, ~/.aws,
# ~/.docker, ~/.kube masked by tmpfs. Verified there: writes to scripts/ and
# AGENTS.md fail with EROFS, reports/ and bd writes succeed, ~/.ssh is empty.
#
# Do not "restore" the directives below to a namespacing set without re-testing
# a real push; the failure is silent in the sense that sweeps still run.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
