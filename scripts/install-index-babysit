#!/usr/bin/env bash
# Install and enable the index-babysit systemd user timer on this machine.
# Re-run after ANY change to scripts/systemd/index-babysit.* — the deployed
# unit does not track the template (drift bit verify-babysit in production,
# see bd memory 'a-tracked-systemd-unit-template-under-scripts-systemd').
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
common_dir="$(git -C "$ROOT" rev-parse --git-common-dir)"
[[ "$common_dir" = /* ]] || common_dir="$ROOT/$common_dir"
STABLE_ROOT="$(cd "$(dirname "$common_dir")" && pwd)"
[[ -x "$STABLE_ROOT/scripts/index-babysit" ]] || { echo "stable checkout is incomplete: $STABLE_ROOT (scripts/index-babysit missing or not executable — install from the MAIN checkout after the branch lands, not from a worktree)" >&2; exit 1; }
[[ ! "$STABLE_ROOT" =~ [[:space:]\"\'\\\;\|\&\$\<\>\`%] ]] || { echo "unsafe systemd path: $STABLE_ROOT" >&2; exit 1; }
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UNIT_DIR"
root_escaped="$(printf '%s' "$STABLE_ROOT" | sed 's/[\\&|]/\\&/g')"
service_tmp="$(mktemp "$UNIT_DIR/.index-babysit.XXXXXX.service")"
timer_tmp="$(mktemp "$UNIT_DIR/index-babysit.timer.XXXXXX")"
trap 'rm -f "$service_tmp" "$timer_tmp"' EXIT
sed "s|@ROOT@|$root_escaped|g" "$ROOT/scripts/systemd/index-babysit.service" >"$service_tmp"
if command -v systemd-analyze >/dev/null 2>&1; then systemd-analyze verify "$service_tmp"; fi
chmod 0644 "$service_tmp"
install -m 0644 "$ROOT/scripts/systemd/index-babysit.timer" "$timer_tmp"
mv -f "$service_tmp" "$UNIT_DIR/index-babysit.service"
mv -f "$timer_tmp" "$UNIT_DIR/index-babysit.timer"
systemctl --user daemon-reload
systemctl --user enable --now index-babysit.timer
systemctl --user list-timers index-babysit.timer --no-pager
