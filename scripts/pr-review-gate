#!/usr/bin/env bash
# pr-review-gate - PreToolUse hook: no `gh pr create` upstream without BOTH a
# cross-vendor review AND a passing red-team verdict for the exact commit
# being proposed.
#
# Why this is a hook and not a sentence in AGENTS.md: it was a sentence in
# AGENTS.md, and compliance turned out to track the session model rather than
# the policy. Measured across 168 transcripts on 2026-08-01, sessions that
# opened an upstream PR also ran `codex-agent reviewer` 47% of the time on
# fable-5 and 23% on opus-5; four Opus sessions on 07-31/08-01 opened 15 PRs
# between them with no cross-vendor review at all. Every other non-negotiable
# in this repo (pr-preflight, verify-enqueue, agent-sig) is an imperative with
# a script behind it. This one was a "may". Now it is a gate.
#
# Reads the PreToolUse JSON on stdin. Exit 0 allows the command; exit 2 blocks
# it and hands the message to the model.
#
# Blocks only when all of these hold:
#   - the command runs `gh pr create`
#   - it targets gastownhall/beads (named with --repo, or inferred from the
#     remotes of the checkout it runs in)
#   - no review log (.review-logs/<sha>.md) or no PASSING red-team verdict
#     (.review-logs/<sha>.redteam.json, written by scripts/red-team) exists
#     for the HEAD sha of any checkout the command plausibly runs in
#   - codex is on PATH, or ~/.codex exists (codex configured but missing from
#     PATH is a broken shell, so that BLOCKS; a host with neither degrades
#     instead of deadlocking)
#
# Escape hatches: prefix the command with MYBD_SKIP_XVENDOR=1 (skips only the
# cross-vendor review requirement) and/or MYBD_SKIP_REDTEAM=1 (skips only the
# red-team requirement); a full bypass needs both, so each skip is a separate
# deliberate act. They live in the command line on purpose. An env var
# exported earlier in the session would silently disarm every later PR too,
# and would not show up in the transcript next to the PR it excused.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# Same main-checkout anchoring as scripts/pr-open, for the same reason.
_common="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[[ -n "$_common" ]] && ROOT="$(dirname "$_common")"
REVIEW_DIR="$ROOT/.worktrees/.review-logs"
UPSTREAM_REPO="gastownhall/beads"

input="$(cat)"
command -v jq >/dev/null 2>&1 || {
  echo "pr-review-gate: WARNING: jq is unavailable; allowing command" >&2
  exit 0
}

lib="$SCRIPT_DIR/lib/hook-payload.sh"
[[ -r "$lib" ]] || { echo "pr-review-gate: WARNING: missing scripts/lib/hook-payload.sh; allowing command" >&2; exit 0; }
source "$lib"
hook_payload_extract "$input"
payload_rc=$?
case "$payload_rc" in
  0)
    cmd="$HOOK_PAYLOAD_COMMAND"
    hook_cwd="$HOOK_PAYLOAD_CWD"
    ;;
  2) exit 0 ;;
  *)
    echo "pr-review-gate: WARNING: unrecognized Bash PreToolUse payload; allowing command" >&2
    exit 0
    ;;
esac

# Two views of the command, because a gate that fires on text inside a string
# would block `printf 'run gh pr create ...'`, and one that ignores quotes
# entirely would read `--repo "gastownhall/beads"` as no --repo at all:
#   cmd_code  - quoted spans blanked; used to decide "is this an invocation?"
#   cmd_flags - quote characters removed; used to read flag VALUES.
cmd_code="$(sed -E "s/'[^']*'/''/g; s/\"[^\"]*\"/\"\"/g" <<<"$cmd")"
cmd_flags="$(tr -d "'\\\"" <<<"$cmd")"

# Not a PR creation, or deliberately excused. `gh pr new` is an official alias
# for `gh pr create`, so gating only the latter leaves the rule one word away
# from being bypassed.
grep -qE '(^|[;&|(]|&&|\|\||[[:space:]])gh[[:space:]]+pr[[:space:]]+(create|new)([[:space:]]|$)' <<<"$cmd_code" || exit 0
# A hatch only counts where the docs put it: as an env-style prefix riding
# the SAME command segment as the gh invocation, before the `gh` word.
# Hatch text elsewhere - another segment of a chained command, a trailing
# comment, an echo - is not a decision about THIS PR. Boundary-anchored on
# both sides: red-teaming this gate with itself read MYBD_SKIP_XVENDOR=10 as
# the =1 hatch (RT-001), and the cross-vendor review of the same branch
# found the whole-command substring match (bypass via any mention anywhere).
gh_seg="$(tr ';&|' '\n' <<<"$cmd_code" \
  | grep -E '(^|[;&|(]|[[:space:]])gh[[:space:]]+pr[[:space:]]+(create|new)([[:space:]]|$)' | head -1)"
hatch_zone="$(sed -E 's/(^|[[:space:](])gh[[:space:]]+pr[[:space:]]+(create|new)([[:space:]].*)?$//' <<<"$gh_seg")"
skip_x=0; skip_rt=0
grep -qE '(^|[[:space:]])MYBD_SKIP_XVENDOR=1([^[:alnum:]]|$)' <<<"$hatch_zone" && skip_x=1
grep -qE '(^|[[:space:]])MYBD_SKIP_REDTEAM=1([^[:alnum:]]|$)' <<<"$hatch_zone" && skip_rt=1
(( skip_x && skip_rt )) && exit 0

# Without codex there is no second vendor to consult. On a host that never
# had codex the gate stands down rather than blocking work it cannot offer a
# path through. On a host that HAS codex configured (~/.codex exists) a missing
# binary is a broken PATH, not a policy choice, and standing down would disarm
# the gate silently - exactly what happened on 2026-09-02 when Bluefin made
# /etc/profile.d/brew.sh interactive-only (bead mybd-zvups). The shared probe
# repairs the common case; what it cannot repair, it refuses loudly.
source "$SCRIPT_DIR/lib/brew-path.sh" 2>/dev/null || true
if ! command -v codex >/dev/null 2>&1; then
  if [[ -d "$HOME/.codex" ]]; then
    cat >&2 <<MSG
pr-review-gate: BLOCKED. codex is not on PATH but ~/.codex exists, so this host
  is codex-configured and the cross-vendor gate cannot verify the PR.
  Likely cause: a non-interactive shell without linuxbrew on PATH. Fix with
    export PATH="\$PATH:/home/linuxbrew/.linuxbrew/bin"
  and re-run. To open the PR without codex, put BOTH MYBD_SKIP_XVENDOR=1 and
  MYBD_SKIP_REDTEAM=1 in front of the gh command and say why in the handoff.
MSG
    exit 2
  fi
  echo "pr-review-gate: codex not installed on this host; cross-vendor gate stands down" >&2
  exit 0
fi

# Which checkouts might this run in? A leading `cd X &&`, an explicit `git -C X`,
# and the session cwd. Any of them having a reviewed HEAD is enough.
# ONE effective directory, not a set of candidates. `gh` runs where the command
# put it: the last `cd` in the command if there is one, else the session cwd.
# Treating every mentioned directory as interchangeable meant
# `cd <unreviewed> && gh pr create` could be satisfied by the reviewed cwd it
# started from. (A `git -C X` says nothing about where gh runs, so it is not a
# candidate at all.)
effective_dir="$hook_cwd"
last_cd="$(grep -oE '(^|&&[[:space:]]*|;[[:space:]]*)cd[[:space:]]+[^;&|]+' <<<"$cmd_flags" \
  | sed -E 's/.*cd[[:space:]]+//; s/[[:space:]]+$//' | tail -1)"
[[ -n "$last_cd" ]] && effective_dir="$last_cd"
[[ -n "$effective_dir" ]] || effective_dir="$PWD"
declare -a dirs=("$effective_dir")

# --repo / -R decides the target when present; otherwise infer from the remotes.
# Both spellings must be read: `gh pr create -R gastownhall/beads` from the
# coordination checkout would otherwise infer maphew/mybd and skip the gate.
# An inline GH_REPO= assignment does the same job for gh, so it counts too.
#
# gh accepts [HOST/]OWNER/REPO, so `--repo github.com/gastownhall/beads` is the
# same target as `gastownhall/beads` and must not read as a different one.
norm_repo() {
  local v="${1%/}"
  if [[ "$(awk -F/ '{print NF}' <<<"$v")" -ge 3 ]]; then
    v="$(awk -F/ '{print $(NF-1)"/"$NF}' <<<"$v")"
  fi
  printf '%s' "$v"
}

target_is_upstream=0
saw_repo_flag=0
# Every selector in the command is considered, not just the first: a chained
# string whose first PR targets somewhere harmless must not speak for a later
# one that targets upstream.
while IFS= read -r raw; do
  [[ -n "$raw" ]] || continue
  saw_repo_flag=1
  [[ "$(norm_repo "$raw")" == "$UPSTREAM_REPO" ]] && target_is_upstream=1
done < <(
  grep -oE -- '(--repo|-R)[=[:space:]]+[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+){1,2}' <<<"$cmd_flags" \
    | sed -E 's/(--repo|-R)[=[:space:]]+//'
  grep -oE 'GH_REPO=[A-Za-z0-9_.:-]+(/[A-Za-z0-9_.-]+){1,2}' <<<"$cmd_flags" | sed -E 's/GH_REPO=//'
)
if (( ! saw_repo_flag )); then
  for d in "${dirs[@]}"; do
    remotes="$(git -C "$d" remote -v 2>/dev/null)" || continue
    if grep -qE '(gastownhall|maphew)/beads' <<<"$remotes"; then target_is_upstream=1; break; fi
  done
fi
(( target_is_upstream )) || exit 0

# One PR per command. Flags cannot be attributed to the right invocation in a
# chained string, and guessing there means guessing about a deletion-shaped
# decision, so this asks for the two commands to be run separately instead.
if [[ "$(grep -cE '(^|[;&|(]|&&|\|\||[[:space:]])gh[[:space:]]+pr[[:space:]]+(create|new)([[:space:]]|$)' <<<"$(tr ';&|' '\n\n\n' <<<"$cmd_code")")" -gt 1 ]]; then
  echo "Blocked: more than one 'gh pr create' in a single command." >&2
  echo "  Which --repo/--head/--base belongs to which invocation cannot be told" >&2
  echo "  apart reliably, so the review check cannot be applied per PR." >&2
  echo "  Run them as separate commands." >&2
  exit 2
fi

# Which commit is actually being proposed? An explicit --head/-H names it, and
# when it resolves it is the ONLY answer: falling back to the cwd's HEAD as well
# would let a reviewed working checkout vouch for an unreviewed branch being
# pushed past it.
declare -a shas=()
unresolved_head=""
head_flag="$(grep -oE -- '(--head|-H)[=[:space:]]+[^[:space:];&|]+' <<<"$cmd_flags" | head -1 | sed -E 's/(--head|-H)[=[:space:]]+//')"
if [[ -n "$head_flag" ]]; then
  ref="${head_flag##*:}"
  # Remote-tracking refs first: gh opens the PR from the branch as it exists on
  # the fork, so a stale local branch of the same name is the wrong commit to
  # check. If the local branch is ahead, the remote ref is what was reviewed
  # only after a push — and gh could not open the PR before one anyway.
  for d in "${dirs[@]}" "$ROOT/bd-main"; do
    for candidate in "origin/$ref" "upstream/$ref" "$ref"; do
      s="$(git -C "$d" rev-parse --verify --quiet "$candidate" 2>/dev/null)" || continue
      [[ -n "$s" ]] && shas+=("$s") && break 2
    done
  done
  # A head named but not found locally is the one case where falling back is
  # worse than stopping: gh can open the PR from a branch that exists only on
  # the remote, and the cwd's HEAD would then vouch for a commit nobody read.
  [[ ${#shas[@]} -eq 0 ]] && unresolved_head="$head_flag"
else
  for d in "${dirs[@]}"; do
    s="$(git -C "$d" rev-parse --verify --quiet HEAD 2>/dev/null)" || continue
    [[ -n "$s" ]] && shas+=("$s")
  done
fi

# The log has to cover the diff being proposed, which means the same base as
# well as the same commit: a review taken against `release` says nothing about
# the same sha opened against `main`.
want_base="$(grep -oE -- '(--base|-B)[=[:space:]]+[^[:space:];&|]+' <<<"$cmd_flags" | head -1 | sed -E 's/(--base|-B)[=[:space:]]+//')"
if [[ -z "$want_base" ]]; then
  # With no --base, gh honours branch.<current>.gh-merge-base before falling
  # back to the repo default, so assuming "main" outright could accept a main
  # review for a PR GitHub opens against something else.
  cur="$(git -C "$effective_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [[ -n "$cur" ]] && want_base="$(git -C "$effective_dir" config --get "branch.$cur.gh-merge-base" 2>/dev/null || true)"
  want_base="${want_base:-main}"
fi
# Both requirements are judged per sha: the same commit needs a cross-vendor
# review log AND a passing red-team verdict, each covering the same base. A
# sha that satisfies only one of the two is still blocked — a clean static
# review says nothing about whether the change survives an adversary, and
# vice versa.
base_mismatch=""
rt_problem=""
x_ok=0; rt_ok=0
for s in ${shas[@]+"${shas[@]}"}; do
  x_ok=$skip_x; rt_ok=$skip_rt
  if (( ! x_ok )); then
    log="$REVIEW_DIR/$s.md"
    if [[ -s "$log" ]]; then
      logged_base="$(sed -nE 's/^- base: `(.*)`$/\1/p' "$log" | head -1)"
      if [[ -z "$logged_base" ]]; then
        # No base line means a truncated or hand-rolled log. It cannot say
        # which diff was read, so it does not count as having read one.
        base_mismatch="the log for ${s:0:12} records no base — treating it as incomplete"
      elif [[ "$logged_base" == "$want_base" ]]; then
        x_ok=1
      else
        base_mismatch="reviewed against \`$logged_base\`, but this PR targets \`$want_base\`"
      fi
    fi
  fi
  if (( ! rt_ok )); then
    rt="$REVIEW_DIR/$s.redteam.json"
    if [[ -s "$rt" ]]; then
      rt_verdict="$(jq -r '.verdict // empty' "$rt" 2>/dev/null)"
      rt_base="$(jq -r '.base // empty' "$rt" 2>/dev/null)"
      # A pass must be a verdict scripts/red-team could have written: head
      # matching the filename, a findings array, a numeric round count, AND
      # internally consistent - zero open P0/P1, none in the findings list.
      # A two-field {verdict,base} stub satisfied the first cut of this check
      # (red-team RT-002), and a "pass" carrying P0/P1 findings satisfied the
      # second (cross-vendor review of the same branch).
      rt_complete="$(jq -r --arg s "$s" \
        'select(.head == $s and (.findings | type == "array") and (.rounds | type == "number")
                and ((.open_p0p1 // 1) == 0)
                and ([.findings[] | select(.severity == "P0" or .severity == "P1")] | length == 0)) | "yes"' \
        "$rt" 2>/dev/null)"
      if [[ "$rt_verdict" == "pass" && "$rt_base" == "$want_base" && "$rt_complete" == "yes" ]]; then
        rt_ok=1
      elif [[ "$rt_verdict" == "fail" ]]; then
        rt_problem="the red-team verdict for ${s:0:12} is FAIL ($(jq -r '.open_p0p1 // "?"' "$rt" 2>/dev/null) open P0/P1, bead $(jq -r '.bead // "not filed"' "$rt" 2>/dev/null)) — this PR should not be opened"
      elif [[ "$rt_verdict" == "pass" && "$rt_complete" != "yes" ]]; then
        rt_problem="the red-team log for ${s:0:12} is not a verdict scripts/red-team could have written (incomplete, or a pass carrying open P0/P1) — treating it as absent"
      elif [[ "$rt_verdict" == "pass" ]]; then
        rt_problem="the red-team run for ${s:0:12} covered base \`$rt_base\`, but this PR targets \`$want_base\`"
      else
        # A verdict that parses to neither pass nor fail is a truncated or
        # hand-rolled log; it does not count as having run the adversary.
        rt_problem="the red-team log for ${s:0:12} is malformed — treating it as absent"
      fi
    fi
  fi
  (( x_ok && rt_ok )) && exit 0
done

reviewed_hint=""
if [[ -d "$REVIEW_DIR" ]]; then
  recent="$(ls -1t "$REVIEW_DIR"/*.md 2>/dev/null | head -3 | while read -r f; do
    b="$(basename "$f" .md)"; printf '    %s\n' "${b:0:12}"; done)"
  [[ -n "$recent" ]] && reviewed_hint=$'\n  Review logs exist, but for other commits:\n'"$recent"
fi

proposed="${shas[0]:-unknown}"
# Name what is actually missing for the commit checked last: both halves, or
# just the one that failed. The two requirements have different remedies.
missing=""
if (( ! x_ok )); then
  missing="cross-vendor review"
  [[ -n "$base_mismatch" ]] && missing="cross-vendor review ($base_mismatch)"
fi
if (( ! rt_ok )); then
  rt_part="passing red-team verdict"
  [[ -n "$rt_problem" ]] && rt_part="passing red-team verdict ($rt_problem)"
  [[ -n "$missing" ]] && missing="$missing AND $rt_part" || missing="$rt_part"
fi
headline="no $missing for the commit this PR would propose"
[[ -n "$unresolved_head" ]] && headline="--head names \`$unresolved_head\`, which does not resolve in $effective_dir, so the commit it would propose cannot be checked"
cat >&2 <<EOF
Blocked: $headline.

  head:   ${proposed:0:12}
  wanted: $REVIEW_DIR/${proposed:0:12}....md (cross-vendor review)
     and: $REVIEW_DIR/${proposed:0:12}....redteam.json with verdict "pass"$reviewed_hint

AGENTS.md requires, before an upstream PR: a second model family on the diff
(an independent vendor catches what same-family agents miss) AND a passing
red-team verdict (an adversary that tried to break the change — failing
tests, regex bypasses, test hermeticity, fixture-state coupling — and
failed). Run:

  scripts/pr-open -C <worktree> --base $want_base --search "<topic keywords>"

which runs the red-team loop and then the review, then reconcile the findings
and retry this command. To run only the missing half: scripts/red-team -C
<worktree> --base $want_base. If HEAD moved since the last run, that is the
gate working: verify the commit you are actually proposing. A red-team FAIL
verdict means do NOT open this PR — a bead with the findings was filed; move
to the next queue item.

Deliberately skipping (codex down, trivial docs typo, owner said so): prefix
this command with MYBD_SKIP_XVENDOR=1 and/or MYBD_SKIP_REDTEAM=1 — each skips
only its own requirement — and say why in the handoff.
EOF
exit 2
