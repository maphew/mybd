#!/usr/bin/env bash
# Install and enable the reap-test-debris systemd user timer on this machine.
#
# Mirrors scripts/install-verify-babysit: the unit must point at the MAIN
# checkout, never at whichever linked worktree happened to run the installer,
# because a worktree can be removed while the timer keeps firing (and because
# bd-main/ - which holds clean-test-tmp.sh - only exists in the main checkout).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
common_dir="$(git -C "$ROOT" rev-parse --git-common-dir)"
[[ "$common_dir" = /* ]] || common_dir="$ROOT/$common_dir"
STABLE_ROOT="$(cd "$(dirname "$common_dir")" && pwd)"
[[ -x "$STABLE_ROOT/scripts/reap-test-debris" ]] || { echo "stable checkout is incomplete: $STABLE_ROOT" >&2; exit 1; }
[[ ! "$STABLE_ROOT" =~ [[:space:]\"\'\\\;\|\&\$\<\>\`%] ]] || { echo "unsafe systemd path: $STABLE_ROOT" >&2; exit 1; }
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UNIT_DIR"
root_escaped="$(printf '%s' "$STABLE_ROOT" | sed 's/[\\&|]/\\&/g')"
service_tmp="$(mktemp "$UNIT_DIR/.reap-test-debris.XXXXXX.service")"
timer_tmp="$(mktemp "$UNIT_DIR/reap-test-debris.timer.XXXXXX")"
trap 'rm -f "$service_tmp" "$timer_tmp"' EXIT
sed "s|@ROOT@|$root_escaped|g" "$ROOT/scripts/systemd/reap-test-debris.service" >"$service_tmp"
if command -v systemd-analyze >/dev/null 2>&1; then systemd-analyze verify "$service_tmp"; fi
chmod 0644 "$service_tmp"
install -m 0644 "$ROOT/scripts/systemd/reap-test-debris.timer" "$timer_tmp"
mv -f "$service_tmp" "$UNIT_DIR/reap-test-debris.service"
mv -f "$timer_tmp" "$UNIT_DIR/reap-test-debris.timer"
systemctl --user daemon-reload
systemctl --user enable --now reap-test-debris.timer
systemctl --user list-timers reap-test-debris.timer --no-pager
