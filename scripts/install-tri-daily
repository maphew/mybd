#!/usr/bin/env bash
# Install and enable the tri-daily systemd user timer on this machine.
# Non-systemd machines use scripts/tri-install-cron instead.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
common_dir="$(git -C "$ROOT" rev-parse --git-common-dir)"
[[ "$common_dir" = /* ]] || common_dir="$ROOT/$common_dir"
STABLE_ROOT="$(cd "$(dirname "$common_dir")" && pwd)"
[[ -x "$STABLE_ROOT/scripts/tri-daily" ]] || { echo "stable checkout is incomplete: $STABLE_ROOT" >&2; exit 1; }
[[ ! "$STABLE_ROOT" =~ [[:space:]\"\'\\\;\|\&\$\<\>\`%] ]] || { echo "unsafe systemd path: $STABLE_ROOT" >&2; exit 1; }
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UNIT_DIR"
root_escaped="$(printf '%s' "$STABLE_ROOT" | sed 's/[\\&|]/\\&/g')"
service_tmp="$(mktemp "$UNIT_DIR/.tri-daily.XXXXXX.service")"
timer_tmp="$(mktemp "$UNIT_DIR/tri-daily.timer.XXXXXX")"
trap 'rm -f "$service_tmp" "$timer_tmp"' EXIT
sed "s|@ROOT@|$root_escaped|g" "$ROOT/scripts/systemd/tri-daily.service" >"$service_tmp"
if command -v systemd-analyze >/dev/null 2>&1; then systemd-analyze verify "$service_tmp"; fi
chmod 0644 "$service_tmp"
install -m 0644 "$ROOT/scripts/systemd/tri-daily.timer" "$timer_tmp"
mv -f "$service_tmp" "$UNIT_DIR/tri-daily.service"
mv -f "$timer_tmp" "$UNIT_DIR/tri-daily.timer"
systemctl --user daemon-reload
systemctl --user enable --now tri-daily.timer
systemctl --user list-timers tri-daily.timer --no-pager
if crontab -l 2>/dev/null | grep -Fq '# mybd tri-daily'; then
  echo "note: a tri-install-cron crontab entry also exists; remove it to avoid double runs" >&2
fi
